<footer 
  id="dynamic-seasonal-footer" 
  class="relative mt-32 overflow-hidden pt-28 pb-12 transition-colors duration-700 bg-gray-50/70 text-gray-900 border-t border-gray-200/80 theme-day-monsoon"
>
  
  <!-- Dynamic Sky Ambient Backdrops -->
  <div class="sky-ambient-layer absolute inset-0 pointer-events-none z-0 transition-opacity duration-700"></div>

  <!-- Celestial Element (Sun or Moon SVG) -->
  <div id="celestial-body" class="celestial-container absolute top-6 right-8 sm:right-16 z-0 pointer-events-none transition-all duration-700 opacity-0">
    <!-- Sun (Daytime Summer/Monsoon/Winter) -->
    <div class="celestial-sun relative w-16 h-16 sm:w-20 sm:h-20">
      <div class="absolute inset-0 rounded-full bg-amber-400/20 blur-xl animate-pulse"></div>
      <div class="w-full h-full rounded-full bg-gradient-to-tr from-amber-500 via-amber-400 to-yellow-200 shadow-[0_0_40px_rgba(251,191,36,0.6)]"></div>
      <!-- Subtle Sun Rays -->
      <svg class="absolute -inset-2 w-[calc(100%+16px)] h-[calc(100%+16px)] text-amber-300/40 animate-spin-slow" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="50" y1="5" x2="50" y2="15"/>
        <line x1="50" y1="85" x2="50" y2="95"/>
        <line x1="5" y1="50" x2="15" y2="50"/>
        <line x1="85" y1="50" x2="95" y2="50"/>
        <line x1="18" y1="18" x2="25" y2="25"/>
        <line x1="75" y1="75" x2="82" y2="82"/>
        <line x1="18" y1="82" x2="25" y2="75"/>
        <line x1="75" y1="25" x2="82" y2="18"/>
      </svg>
    </div>

    <!-- Crescent Moon with Craters (Nighttime) -->
    <div class="celestial-moon relative w-16 h-16 sm:w-20 sm:h-20 hidden">
      <div class="absolute inset-0 rounded-full bg-indigo-300/10 blur-xl"></div>
      <svg class="w-full h-full drop-shadow-[0_0_20px_rgba(224,231,255,0.4)]" viewBox="0 0 100 100">
        <defs>
          <linearGradient id="moonGlow" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#f8fafc" />
            <stop offset="70%" stop-color="#e2e8f0" />
            <stop offset="100%" stop-color="#cbd5e1" />
          </linearGradient>
        </defs>
        <path d="M50 10 A40 40 0 1 0 90 50 A30 30 0 1 1 50 10 Z" fill="url(#moonGlow)"/>
        <!-- Moon texture / subtle craters -->
        <circle cx="36" cy="40" r="4" fill="#94a3b8" opacity="0.3"/>
        <circle cx="48" cy="62" r="6" fill="#94a3b8" opacity="0.25"/>
        <circle cx="28" cy="56" r="3" fill="#94a3b8" opacity="0.2"/>
      </svg>
    </div>
  </div>

  <!-- Twinkling Stars Layer (Active in Night Mode) -->
  <div id="stars-layer" class="absolute inset-0 pointer-events-none z-0 overflow-hidden hidden">
    {Array.from({ length: 45 }).map((_, i) => (
      <div 
        class="star-twinkle absolute rounded-full bg-white"
        style={`
          width: ${1 + (i % 3)}px; 
          height: ${1 + (i % 3)}px; 
          top: ${(i * 2.2) % 75}%; 
          left: ${(i * 3.7) % 98}%; 
          animation-delay: ${(i * 0.25) % 3}s; 
          animation-duration: ${1.5 + (i % 3)}s;
        `}
      ></div>
    ))}
  </div>

  <!-- Dynamic Seasonal Particles (Rain / Snow / Heat Embers) -->
  <div id="particles-container" class="absolute inset-0 pointer-events-none z-0 overflow-hidden">
    {particles.map(p => (
      <div 
        class="dynamic-particle absolute"
        style={`left: ${p.left}%; animation-delay: ${p.delay}s; animation-duration: ${p.duration}s;`}
      ></div>
    ))}
  </div>

  <!-- Tall River / Dune / Snow Drift Flow Animation -->
  <div class="absolute bottom-0 left-0 w-full h-[220px] pointer-events-none z-0">
    <div class="waves-fade-top absolute bottom-0 w-full h-[120px] transition-colors duration-700"></div>
    
    <!-- Flowing Wave 1 (Back) -->
    <svg class="absolute bottom-0 w-[200%] h-[180px] river-flow-1 wave-layer-1 transition-colors duration-700" viewBox="0 0 2000 100" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path class="wave-path-1" d="M0,50 Q250,100 500,50 T1000,50 T1500,50 T2000,50 V100 H0 Z" />
    </svg>
    
    <!-- Flowing Wave 2 (Middle) -->
    <svg class="absolute bottom-0 w-[200%] h-[130px] river-flow-2 wave-layer-2 transition-colors duration-700" viewBox="0 0 2000 100" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path class="wave-path-2" d="M0,70 Q250,20 500,70 T1000,70 T1500,70 T2000,70 V100 H0 Z" />
    </svg>

    <!-- Flowing Wave 3 (Front) -->
    <svg class="absolute bottom-0 w-[200%] h-[80px] river-flow-3 wave-layer-3 transition-colors duration-700" viewBox="0 0 2000 100" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path class="wave-path-3" d="M0,40 Q250,90 500,40 T1000,40 T1500,40 T2000,40 V100 H0 Z" />
    </svg>
  </div>

