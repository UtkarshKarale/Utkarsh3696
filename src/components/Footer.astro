</footer>

<script is:inline>
  (function initDynamicFooter() {
    const footer = document.getElementById('dynamic-seasonal-footer');
    const badge = document.getElementById('season-badge');
    const celestial = document.getElementById('celestial-body');
    const starsLayer = document.getElementById('stars-layer');
    const clockEl = document.getElementById('footer-live-clock');
    if (!footer) return;

    const now = new Date();
    const month = now.getMonth(); // 0 = Jan ... 11 = Dec
    const hours = now.getHours();

    // Determine Day vs Night
    // Night is roughly 7 PM (19) to 5:59 AM (5)
    const isNight = hours >= 19 || hours < 6;

    // Determine Season
    // Winter: Nov (10), Dec (11), Jan (0), Feb (1)
    // Summer: Mar (2), Apr (3), May (4)
    // Monsoon / Rainy: Jun (5), Jul (6), Aug (7), Sep (8), Oct (9)
    let season = 'monsoon';
    let seasonLabel = 'Monsoon Rain';
    if (month >= 2 && month <= 4) {
      season = 'summer';
      seasonLabel = 'Summer Breeze';
    } else if (month >= 10 || month <= 1) {
      season = 'winter';
      seasonLabel = 'Winter Chill';
    }

    const timeLabel = isNight ? 'Night' : 'Day';
    const themeClass = `theme-${isNight ? 'night' : 'day'}-${season}`;

    // Apply class to footer container
    footer.className = `relative mt-32 overflow-hidden pt-28 pb-12 transition-all duration-700 ${themeClass}`;

    // Update Celestial visuals (Sun vs Moon)
    if (celestial) {
      celestial.style.opacity = '1';
      const sun = celestial.querySelector('.celestial-sun');
      const moon = celestial.querySelector('.celestial-moon');
      if (isNight) {
        if (sun) sun.classList.add('hidden');
        if (moon) moon.classList.remove('hidden');
        if (starsLayer) starsLayer.classList.remove('hidden');
      } else {
        if (sun) sun.classList.remove('hidden');
        if (moon) moon.classList.add('hidden');
        if (starsLayer) starsLayer.classList.add('hidden');
      }
    }

    // Update Badge text & styling
    if (badge) {
      badge.textContent = `${seasonLabel} • ${timeLabel}`;
    }

    // Live formatted clock
    if (clockEl) {
      const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      clockEl.textContent = `Local Time: ${timeStr} • ${seasonLabel}`;
    }
  })();
</script>

<style>
  /* ============================================================
     1. BASE PARTICLE ANIMATIONS (Rain, Snow, Heat)
     ============================================================ */
  
  /* Fall animation for Rain & Snow */
  @keyframes particleFall {
    0% { transform: translateY(-40px); opacity: 0; }
    15% { opacity: 0.9; }
    80% { opacity: 0.8; }
    100% { transform: translateY(420px); opacity: 0; }
  }

  /* Float animation for Heat shimmer / Embers */
  @keyframes heatRise {
    0% { transform: translateY(350px) scale(0.6); opacity: 0; }
    25% { opacity: 0.6; }
    75% { opacity: 0.8; transform: translateY(100px) scale(1.1) translateX(8px); }
    100% { transform: translateY(-40px) scale(0.4) translateX(-8px); opacity: 0; }
  }

  /* Star twinkle */
  @keyframes starPulse {
    0%, 100% { opacity: 0.2; transform: scale(0.8); }
    50% { opacity: 1; transform: scale(1.3); }
  }
  .star-twinkle {
    animation: starPulse infinite ease-in-out;
  }

  .animate-spin-slow {
    animation: spinRays 35s linear infinite;
  }
  @keyframes spinRays {
    100% { transform: rotate(360deg); }
  }

  /* River wave flow animations */
  .river-flow-1 { animation: waveFlow 22s linear infinite; }
  .river-flow-2 { animation: waveFlow 16s linear infinite reverse; }
  .river-flow-3 { animation: waveFlow 11s linear infinite; }
  @keyframes waveFlow {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* ============================================================
     2. THEME DEFINITIONS (Combinations of Day/Night x Season)
     ============================================================ */

  /* ---------------- MONSOON (DAY) ---------------- */
  .theme-day-monsoon {
    background-color: #f8fafc;
    color: #0f172a;
    border-color: #e2e8f0;
  }
  .theme-day-monsoon .sky-ambient-layer {
    background: radial-gradient(circle at top right, rgba(186, 230, 253, 0.35), transparent 70%);
  }
  .theme-day-monsoon .dynamic-particle {
    width: 2px;
    height: 14px;
    background: linear-gradient(to bottom, transparent, #38bdf8);
    border-radius: 999px;
    animation: particleFall linear infinite;
  }
  .theme-day-monsoon .waves-fade-top { background: linear-gradient(to top, rgba(224, 242, 254, 0.7), transparent); }
  .theme-day-monsoon .wave-layer-1 { opacity: 0.35; }
  .theme-day-monsoon .wave-path-1 { fill: #e0f2fe; }
  .theme-day-monsoon .wave-layer-2 { opacity: 0.5; }
  .theme-day-monsoon .wave-path-2 { fill: #bae6fd; }
  .theme-day-monsoon .wave-layer-3 { opacity: 0.7; }
  .theme-day-monsoon .wave-path-3 { fill: #7dd3fc; }
  .theme-day-monsoon #season-badge {
    background: #e0f2fe; color: #0369a1; border-color: #bae6fd;
  }
  .theme-day-monsoon .footer-brand-heading { color: #0f172a; }
  .theme-day-monsoon .footer-subtext { color: #475569; }
  .theme-day-monsoon .footer-pill-btn { background: #ffffff; border-color: #e2e8f0; color: #1e293b; }
  .theme-day-monsoon .footer-pill-btn:hover { border-color: #94a3b8; color: #000; }
  .theme-day-monsoon .footer-cta-btn { background: #f0f9ff; border-color: #bae6fd; color: #0284c7; }
  .theme-day-monsoon .footer-cta-btn:hover { background: #e0f2fe; color: #0369a1; }
  .theme-day-monsoon .footer-col-title { color: #0f172a; }
  .theme-day-monsoon .footer-dot { background-color: #0ea5e9; }
  .theme-day-monsoon .footer-link { color: #64748b; }
  .theme-day-monsoon .footer-link:hover { color: #0f172a; }

  /* ---------------- MONSOON (NIGHT) ---------------- */
  .theme-night-monsoon {
    background-color: #0b132b;
    color: #e2e8f0;
    border-color: #1e293b;
  }
  .theme-night-monsoon .sky-ambient-layer {
    background: radial-gradient(circle at top right, rgba(30, 41, 59, 0.7), transparent 70%);
  }
  .theme-night-monsoon .dynamic-particle {
    width: 2px;
    height: 14px;
    background: linear-gradient(to bottom, transparent, rgba(56, 189, 248, 0.7));
    border-radius: 999px;
    animation: particleFall linear infinite;
  }
  .theme-night-monsoon .waves-fade-top { background: linear-gradient(to top, rgba(15, 23, 42, 0.8), transparent); }
  .theme-night-monsoon .wave-layer-1 { opacity: 0.3; }
  .theme-night-monsoon .wave-path-1 { fill: #1e293b; }
  .theme-night-monsoon .wave-layer-2 { opacity: 0.45; }
  .theme-night-monsoon .wave-path-2 { fill: #0f2b48; }
  .theme-night-monsoon .wave-layer-3 { opacity: 0.7; }
  .theme-night-monsoon .wave-path-3 { fill: #03446a; }
  .theme-night-monsoon #season-badge {
    background: rgba(14, 165, 233, 0.15); color: #7dd3fc; border-color: rgba(56, 189, 248, 0.3);
  }
  .theme-night-monsoon .footer-brand-heading { color: #f8fafc; }
  .theme-night-monsoon .footer-subtext { color: #94a3b8; }
  .theme-night-monsoon .footer-pill-btn { background: #1e293b; border-color: #334155; color: #f1f5f9; }
  .theme-night-monsoon .footer-pill-btn:hover { border-color: #64748b; color: #ffffff; }
  .theme-night-monsoon .footer-cta-btn { background: rgba(14, 165, 233, 0.15); border-color: rgba(56, 189, 248, 0.3); color: #38bdf8; }
  .theme-night-monsoon .footer-cta-btn:hover { background: rgba(14, 165, 233, 0.25); color: #7dd3fc; }
  .theme-night-monsoon .footer-col-title { color: #f8fafc; }
  .theme-night-monsoon .footer-dot { background-color: #38bdf8; }
  .theme-night-monsoon .footer-link { color: #94a3b8; }
  .theme-night-monsoon .footer-link:hover { color: #ffffff; }

  /* ---------------- SUMMER (DAY) ---------------- */
  .theme-day-summer {
    background-color: #fffbeb;
    color: #451a03;
    border-color: #fde68a;
  }
  .theme-day-summer .sky-ambient-layer {
    background: radial-gradient(circle at top right, rgba(254, 240, 138, 0.4), transparent 70%);
  }
  .theme-day-summer .dynamic-particle {
    width: 3px;
