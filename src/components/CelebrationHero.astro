---
import fs from 'node:fs';
import path from 'node:path';

const musicDir = path.join(process.cwd(), 'public', 'music');
let tracks = [];
try {
  const files = fs.readdirSync(musicDir).filter(file => file.endsWith('.mp3'));
  tracks = files.map((file, index) => {
    let title = file.replace(/\.[^/.]+$/, "");
    let artist = "Patriotic";
    
    // Attempt to extract artist if separated by " - " or " = "
    if (title.includes(' - ')) {
      const parts = title.split(' - ');
      title = parts[0].trim();
      artist = parts.slice(1).join(' - ').trim();
    } else if (title.includes(' = ')) {
      const parts = title.split(' = ');
      title = parts[0].trim();
      artist = parts.slice(1).join(' = ').trim();
    }
    
    return {
      id: index + 1,
      title,
      artist,
      file: `/music/${file}`
    };
  });
} catch (e) {
  console.error("Could not read music directory", e);
}
