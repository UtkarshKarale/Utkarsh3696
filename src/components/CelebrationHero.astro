<script define:vars={{ tracks }}>
(function () {
  const audio = document.getElementById('ch-audio');
  const titleEl = document.getElementById('ch-title');
  const artistEl = document.getElementById('ch-artist');
  const fillEl = document.getElementById('ch-fill');
  const timeEl = document.getElementById('ch-time');
  const seekEl = document.getElementById('ch-seek');
  const vinyl = document.getElementById('ch-vinyl');
  const artBtn = document.getElementById('ch-art-btn');
  const playBtn = document.getElementById('ch-play');
  const playIcon = document.getElementById('ch-play-icon');
  const prevBtn = document.getElementById('ch-prev');
  const nextBtn = document.getElementById('ch-next');
  const queueBtn = document.getElementById('ch-queue-btn');
  const queueEl = document.getElementById('ch-queue');
  const queueList = document.getElementById('ch-queue-list');
  const queueScrim = document.getElementById('ch-queue-scrim');

  let idx = Math.floor(Math.random() * tracks.length);
  let playing = false;

  function fmt(s) {
    if (!isFinite(s)) return '0:00';
    const m = Math.floor(s / 60);
    const sec = Math.floor(s % 60);
    return m + ':' + String(sec).padStart(2, '0');
  }

  function loadTrack(i, autoplay) {
    idx = ((i % tracks.length) + tracks.length) % tracks.length;
    const t = tracks[idx];
    titleEl.textContent = t.title;
    artistEl.textContent = t.artist;
    audio.src = t.file;
    fillEl.style.width = '0%';
    timeEl.textContent = '0:00 / 0:00';
    renderQueue();
    if (autoplay) audio.play().then(() => setPlaying(true)).catch(() => setPlaying(false));
  }

  function setPlaying(v) {
    playing = v;
    vinyl.classList.toggle('spinning', v);
    if (v) {
      playIcon.innerHTML = '<rect x="6" y="5" width="4" height="14" rx="1" fill="currentColor"/><rect x="14" y="5" width="4" height="14" rx="1" fill="currentColor"/>';
    } else {
      playIcon.innerHTML = '<path d="M8 5.5v13l11-6.5-11-6.5Z" fill="currentColor"/>';
    }
  }

  function togglePlay() {
    if (audio.paused) {
      audio.play().then(() => setPlaying(true)).catch(() => setPlaying(false));
    } else {
      audio.pause();
      setPlaying(false);
    }
  }

  function renderQueue() {
    queueList.innerHTML = '';
    const chakraArt = "https://imgs.search.brave.com/mlWovF0EtVMpZ8dm3k0yPUKFzEz2fAi8XuafVOHjFl0/rs:fit:500:0:1:0/g:ce/aHR0cHM6Ly9tYXJr/ZXRwbGFjZS5jYW52/YS5jb20vaTFuR0Ev/TUFHYmlkaTFuR0Ev/MS90bC9jYW52YS1h/c2hva2EtY2hha3Jh/LW5hdGlvbmFsLWVt/YmxlbS1ncmFwaGlj/LU1BR2JpZGkxbkdB/LnBuZw";
    
    document.getElementById('ch-queue-count').textContent = `${tracks.length} track${tracks.length === 1 ? "" : "s"}`;
    
    tracks.forEach((t, i) => {
      const active = i === idx;
      const btn = document.createElement('button');
      btn.className = 'ch-queue-item' + (active ? ' is-active' : '');
      btn.innerHTML = `
        <img class="ch-queue-art" src="${chakraArt}" alt="" />
        <span class="ch-queue-meta">
          <span class="ch-queue-title">${t.title}</span>
          <span class="ch-queue-artist">${t.artist}</span>
        </span>
        ${active ? '<span class="ch-queue-eq" aria-hidden="true"></span>' : ''}
      `;
      btn.addEventListener('click', () => { 
        loadTrack(i, true); 
        queueEl.hidden = true; 
        queueScrim.hidden = true; 
      });
      queueList.appendChild(btn);
    });
  }

  audio.addEventListener('timeupdate', () => {
    const d = audio.duration || 0;
    const c = audio.currentTime || 0;
    fillEl.style.width = d ? (c / d * 100) + '%' : '0%';
    timeEl.textContent = fmt(c) + ' / ' + fmt(d);
  });
  audio.addEventListener('ended', () => loadTrack(idx + 1, true));

  seekEl.addEventListener('click', (e) => {
    const rect = seekEl.getBoundingClientRect();
    const ratio = Math.min(1, Math.max(0, (e.clientX - rect.left) / rect.width));
    if (audio.duration) audio.currentTime = ratio * audio.duration;
  });

  playBtn.addEventListener('click', togglePlay);
  artBtn.addEventListener('click', togglePlay);
  prevBtn.addEventListener('click', () => loadTrack(idx - 1, playing));
  nextBtn.addEventListener('click', () => loadTrack(idx + 1, playing));

  queueBtn.addEventListener('click', () => { 
    const h = queueEl.hidden;
    queueEl.hidden = !h;
    queueScrim.hidden = !h;
  });
  queueScrim.addEventListener('click', () => { 
    queueEl.hidden = true;
    queueScrim.hidden = true;
  });

  // Responsive background via matchMedia
  const bgImg = document.getElementById('ch-bg-img');
  const mql = window.matchMedia('(max-width: 768px)');
  function updateBg(e) { bgImg.src = e.matches ? '/mobile-india.webp' : '/windows-indai.webp'; }
  mql.addEventListener('change', updateBg);
  updateBg(mql);

  // Live seconds countdown to 15 August 2026
  (function() {
    const el = document.getElementById('ch-countdown');
    if (!el) return;
    const target = new Date('2026-08-15T00:00:00+05:30').getTime();
    function tick() {
      const diff = Math.floor((target - Date.now()) / 1000);
      if (diff <= 0) { el.textContent = ''; return; }
      const d = Math.floor(diff / 86400);
      const h = Math.floor((diff % 86400) / 3600);
      const m = Math.floor((diff % 3600) / 60);
      const s = diff % 60;
      el.textContent = `${d}d ${String(h).padStart(2,'0')}h ${String(m).padStart(2,'0')}m ${String(s).padStart(2,'0')}s`;
    }
    tick();
    setInterval(tick, 1000);
  })();

  // Start
  loadTrack(idx, false);
})();
</script>
