---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;

// Generate a unique beautiful gradient for projects without images
const generateGradient = (id: string) => {
  const hash = id.split('').reduce((acc, char) => char.charCodeAt(0) + ((acc << 5) - acc), 0);
  const hue1 = Math.abs(hash % 360);
  const hue2 = (hue1 + 40) % 360;
  return `linear-gradient(135deg, hsl(${hue1}, 80%, 35%), hsl(${hue2}, 80%, 25%))`;
};

const bgStyle = project.data.coverImage ? `background-image: url('${project.data.coverImage}')` : `background: ${generateGradient(project.id)}`;
---

<a href={`/projects/${project.id}`} class="spotlight-card group flex flex-col h-[22rem] p-6 rounded-[2rem] border border-gray-100/20 transition-all duration-500 relative overflow-hidden hover:-translate-y-2 hover:shadow-2xl hover:shadow-gray-300/50 dark:hover:shadow-black/60">
  
  <!-- Full Background Image/Gradient -->
  <div class="absolute inset-0 w-full h-full bg-cover bg-center transition-transform duration-700 ease-out group-hover:scale-110 z-0" style={bgStyle}></div>
  
  <!-- Dark Gradient Overlay for Text Readability -->
  <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/40 to-black/10 z-0 transition-opacity duration-500 group-hover:opacity-90"></div>

  <!-- Spotlight Overlay -->
  <div class="pointer-events-none absolute -inset-px rounded-[2rem] opacity-0 transition-opacity duration-300 group-hover:opacity-100 z-10"
       style="background: radial-gradient(600px circle at var(--x) var(--y), rgba(255,255,255,0.15), transparent 40%);">
  </div>

  <div class="relative z-10 flex flex-col h-full text-white">
    <!-- Top row: Icon and Arrow -->
    <div class="flex justify-between items-start mb-auto">
      <div class="w-12 h-12 flex-shrink-0 rounded-full bg-white/20 backdrop-blur-xl border border-white/30 flex items-center justify-center text-xl font-black text-white shadow-xl drop-shadow-md">
        {project.data.title.charAt(0).toUpperCase()}
      </div>
      <div class="w-10 h-10 flex-shrink-0 rounded-full bg-white/10 backdrop-blur-md border border-white/20 flex items-center justify-center transform transition-all duration-500 group-hover:bg-white group-hover:rotate-45 shadow-lg">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-white group-hover:text-black transition-colors"><line x1="7" y1="17" x2="17" y2="7"></line><polyline points="7 7 17 7 17 17"></polyline></svg>
      </div>
    </div>
    
    <!-- Bottom row: Title, Description, Tags -->
    <div class="mt-auto">
      <h3 class="text-2xl md:text-3xl font-bold tracking-tight transition-transform duration-300 origin-left group-hover:-translate-y-1 drop-shadow-lg leading-tight mb-2">
        {project.data.title}
      </h3>
      
      <p class="text-sm text-gray-200 leading-relaxed line-clamp-2 drop-shadow-md mb-4 group-hover:-translate-y-1 transition-transform duration-300 delay-75">
        {project.data.description}
      </p>
      
      <!-- Animated Tags -->
      <div class="flex flex-wrap gap-2 transform translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500 max-h-0 group-hover:max-h-20 overflow-hidden">
        {project.data.technologies.slice(0, 4).map((tech) => (
          <span class="inline-flex items-center rounded-lg bg-white/90 backdrop-blur-sm px-2.5 py-1.5 text-[10px] font-bold uppercase tracking-wider text-black shadow-sm">
            {tech}
          </span>
        ))}
        {project.data.technologies.length > 4 && (
          <span class="inline-flex items-center rounded-lg bg-white/90 backdrop-blur-sm px-2.5 py-1.5 text-[10px] font-bold uppercase tracking-wider text-black shadow-sm">
            +{project.data.technologies.length - 4}
          </span>
        )}
      </div>
    </div>
  </div>
</a>
