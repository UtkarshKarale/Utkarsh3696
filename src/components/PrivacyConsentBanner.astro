---
// Minimal Privacy & Cookie Acceptance Consent Bar
---

<div 
  id="privacy-consent-banner" 
  class="fixed bottom-5 left-5 z-[99990] max-w-sm w-[calc(100%-40px)] sm:w-auto bg-gray-900 text-white rounded-2xl p-4 shadow-2xl border border-gray-800 transition-all duration-300 opacity-0 translate-y-4 pointer-events-none"
  role="dialog"
  aria-live="polite"
  aria-label="Privacy and cookies notice"
>
  <div class="flex items-start gap-3">
    <div class="p-2 rounded-xl bg-gray-800 text-emerald-400 shrink-0">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
    </div>
    
    <div class="flex-grow">
      <p class="text-xs font-semibold text-gray-200 leading-snug">
        Privacy First
      </p>
      <p class="text-[11px] text-gray-400 mt-0.5 leading-relaxed">
        This portfolio uses minimal local storage to remember your preferences. No third-party ad trackers or sales pixels are loaded.
      </p>

      <div class="mt-3 flex items-center gap-2">
        <button 
          id="accept-privacy-btn" 
          class="text-xs font-bold bg-white text-gray-900 px-3.5 py-1.5 rounded-lg hover:bg-gray-100 active:scale-95 transition-all cursor-pointer"
        >
          Got it
        </button>
        <a 
          href="/leadpluck/privacy" 
          class="text-[11px] text-gray-400 hover:text-white font-medium underline underline-offset-2 transition-colors ml-1"
        >
          Privacy terms
        </a>
      </div>
    </div>

    <!-- Dismiss close button -->
    <button 
      id="close-privacy-btn" 
      class="text-gray-400 hover:text-white p-1 rounded-lg transition-colors cursor-pointer"
      aria-label="Dismiss notice"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
  </div>
</div>

<script is:inline>
  (function initConsentBanner() {
    const banner = document.getElementById('privacy-consent-banner');
    const acceptBtn = document.getElementById('accept-privacy-btn');
    const closeBtn = document.getElementById('close-privacy-btn');
    if (!banner) return;

    // Check if user has previously acknowledged
    const consentGiven = localStorage.getItem('site_privacy_acknowledged');
    if (consentGiven === 'true') {
      return;
    }

    // Delay display slightly so it doesn't obstruct initial layout
    setTimeout(() => {
      banner.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
    }, 1200);

    function acknowledge() {
      localStorage.setItem('site_privacy_acknowledged', 'true');
      banner.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
    }

    if (acceptBtn) acceptBtn.addEventListener('click', acknowledge);
    if (closeBtn) closeBtn.addEventListener('click', acknowledge);
  })();
</script>
