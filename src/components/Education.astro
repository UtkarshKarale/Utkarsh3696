---
const educationList = [
  {
    degree: "Master of Technology, Computer Engineering",
    institution: "Ashokrao Mane Group of Institutions",
    period: "2025 - 2027",
    description: "Rapidly Growing Institute in Western Maharashtra."
  },
  {
    degree: "Bachelor of Technology, Computer Science and Engineering",
    institution: "Ashokrao Mane Group of Institutions",
    period: "2021 - 2024",
    description: "Rapidly Growing Institute in Western Maharashtra."
  }
];
---

<section id="education" class="py-20 border-t border-gray-100">
  <div class="max-w-4xl mx-auto px-6">
    <h2 class="text-2xl font-bold text-gray-900 mb-8">Education</h2>
    
    <div class="space-y-8">
      {educationList.map((edu) => (
        <div>
          <div class="flex flex-col md:flex-row md:items-baseline justify-between mb-2">
            <h3 class="text-lg font-bold text-gray-900">{edu.degree}</h3>
            <span class="text-sm text-gray-500 font-medium md:ml-4 whitespace-nowrap">{edu.period}</span>
          </div>
          <div class="text-gray-900 font-medium mb-2">{edu.institution}</div>
          <p class="text-gray-500 text-sm">
            {edu.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
