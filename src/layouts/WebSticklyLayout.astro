---
interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = "WebStickly — Pin sticky notes to any webpage. Your thoughts, always in context." 
} = Astro.props;

const currentYear = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400;0,14..32,500;0,14..32,600;0,14..32,700;0,14..32,900;1,14..32,400&display=swap" rel="stylesheet">
  </head>
  <body class="bg-zinc-50 dark:bg-[#18181b] text-zinc-900 dark:text-[#f4f4f5] font-sans antialiased min-h-screen flex flex-col relative selection:bg-yellow-400 selection:text-black">
    
    <!-- Launch Celebration Topbar -->
    <div class="ws-launch-bar">
      <span class="ws-launch-confetti" aria-hidden="true">🎉</span>
      <span class="ws-launch-text">
        <strong>WebStickly 2.0.0</strong> is now live! &nbsp;·&nbsp; Available on Chrome Web Store
      </span>
      <a href="https://chromewebstore.google.com/detail/webstickly/eakcpfpnomihnblennikolojepcdkghm" target="_blank" rel="noopener noreferrer" class="ws-launch-badge hover:bg-yellow-500/20 transition-colors">Get it now</a>
      <span class="ws-launch-confetti" aria-hidden="true">🎉</span>
    </div>

    <!-- Dot grid background -->
    <div class="fixed inset-0 z-[-1] h-full w-full bg-zinc-50 dark:bg-[#18181b] bg-[radial-gradient(#d4d4d8_1px,transparent_1px)] dark:bg-[radial-gradient(#3f3f46_1px,transparent_1px)] [background-size:16px_16px] opacity-50 dark:opacity-30"></div>

    <!-- Header / Navigation -->
    <header class="fixed top-[36px] w-full border-b border-zinc-200 dark:border-zinc-800 bg-white/90 dark:bg-[#18181b]/90 backdrop-blur-md z-50 shadow-sm dark:shadow-none">
      <div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between gap-4">
        <!-- Logo -->
        <a href="/webstickly" class="text-xl font-black tracking-tighter text-zinc-900 dark:text-white flex items-center gap-2 shrink-0">
          <span class="bg-gradient-to-br from-[#facc15] to-[#fb923c] text-black px-2 py-0.5 rounded shadow-sm text-sm transform -rotate-2">WS</span>
          WebStickly
          <span class="ws-version-chip">v2.0.0</span>
        </a>
        <!-- Nav links -->
        <nav class="flex items-center gap-5">
          <a href="/" class="text-sm font-medium text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-colors hidden md:flex items-center gap-1.5 mr-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            Back to Portfolio
          </a>
          <a href="/webstickly" class="text-sm font-medium text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-colors hidden sm:block">Home</a>
          <a href="/webstickly#demo" class="text-sm font-medium text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-colors hidden sm:block">Demo</a>
          <a href="/webstickly#features" class="text-sm font-medium text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-colors hidden sm:block">Features</a>
          <a href="/webstickly/privacy" class="text-sm font-medium text-zinc-500 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-colors hidden sm:block">Privacy</a>
          <!-- Install CTA -->
          <a href="https://chromewebstore.google.com/detail/webstickly/eakcpfpnomihnblennikolojepcdkghm" target="_blank" rel="noopener noreferrer" class="ws-nav-cta hover:scale-[1.02] active:scale-95">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
            Add to Chrome
          </a>
        </nav>
      </div>
    </header>

    <main class="flex-grow pt-[calc(36px+64px)]">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-zinc-200 dark:border-zinc-800 bg-white/50 dark:bg-[#18181b]/50 backdrop-blur-sm py-12 mt-20">
      <div class="max-w-5xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="flex items-center gap-3">
          <span class="bg-gradient-to-br from-[#facc15] to-[#fb923c] text-black px-2 py-0.5 rounded text-sm font-black transform -rotate-2">WS</span>
          <p class="text-sm text-zinc-500 font-medium">&copy; {currentYear} WebStickly. All rights reserved.</p>
        </div>
        <div class="flex gap-6">
          <a href="/webstickly/privacy" class="text-sm font-medium text-zinc-500 hover:text-white transition-colors">Privacy Policy</a>
          <a href="/webstickly#demo" class="text-sm font-medium text-zinc-500 hover:text-white transition-colors">Try Demo</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  /* ── Launch topbar ──────────────────────────────────────── */
  .ws-launch-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: linear-gradient(90deg, #1a1200, #2d1f00, #1a1200);
    border-bottom: 1px solid rgba(250,204,21,0.2);
    font-size: 13px;
    font-weight: 500;
    color: #fde68a;
    overflow: hidden;
  }
  .ws-launch-bar::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent 0%, rgba(250,204,21,0.08) 50%, transparent 100%);
    animation: ws-bar-shimmer 3s ease infinite;
  }
  @keyframes ws-bar-shimmer {
    0%   { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
  }
  .ws-launch-confetti { font-size: 14px; animation: ws-bounce 2s ease-in-out infinite; }
  .ws-launch-confetti:last-child { animation-delay: 0.4s; }
  @keyframes ws-bounce {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-3px); }
  }
  .ws-launch-text strong { color: #facc15; }
  .ws-launch-badge {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: 999px;
    background: rgba(250,204,21,0.15);
    border: 1px solid rgba(250,204,21,0.3);
    color: #facc15;
  }

  /* ── Version chip ───────────────────────────────────────── */
  .ws-version-chip {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 2px 7px;
    border-radius: 999px;
    background: rgba(250,204,21,0.12);
    border: 1px solid rgba(250,204,21,0.25);
    color: #facc15;
    margin-left: 2px;
  }

  /* ── Nav CTA ────────────────────────────────────────────── */
  .ws-nav-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 700;
    padding: 7px 16px;
    border-radius: 10px;
    background: linear-gradient(135deg, #facc15, #fb923c);
    color: #000;
    text-decoration: none;
    transition: opacity 0.2s, transform 0.2s;
    white-space: nowrap;
    cursor: pointer;
  }
  .ws-nav-cta:hover { opacity: 0.9; transform: translateY(-1px); }
  .ws-nav-cta-disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }
  .ws-nav-cta-disabled:hover { opacity: 0.65; transform: none; }
</style>
