---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { 
  title, 
  description = "LeadPluck — Local-First Lead Generator & Google Maps Contact Plucker." 
} = Astro.props;

const currentYear = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/leadpluck/icon-512.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400;0,14..32,500;0,14..32,600;0,14..32,700;0,14..32,900;1,14..32,400&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#0f0f12] text-zinc-100 font-sans antialiased min-h-screen flex flex-col relative selection:bg-purple-600 selection:text-white">
    
    <!-- Background Grid Effect -->
    <div class="fixed inset-0 z-[-1] h-full w-full bg-[#0f0f12] bg-[radial-gradient(#27272a_1px,transparent_1px)] [background-size:24px_24px] opacity-40 pointer-events-none"></div>

    <!-- Header Navigation -->
    <header class="fixed top-0 w-full border-b border-zinc-800/80 bg-[#0f0f12]/90 backdrop-blur-md z-50 shadow-sm">
      <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between gap-4">
        <!-- Logo -->
        <a href="/leadpluck" class="text-xl font-black tracking-tight text-white flex items-center gap-2.5 shrink-0 group">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-purple-500 to-indigo-600 flex items-center justify-center text-white shadow-md font-black text-sm group-hover:scale-105 transition-transform">
            LP
          </div>
          <span>LeadPluck</span>
          <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-purple-500/10 text-purple-400 border border-purple-500/20">v0.6.0</span>
        </a>

        <!-- Navigation Links -->
        <nav class="flex items-center gap-6">
          <a href="/" class="text-xs font-semibold text-zinc-400 hover:text-white transition-colors hidden md:flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            Portfolio
          </a>
          <a href="/projects" class="text-xs font-semibold text-zinc-400 hover:text-white transition-colors hidden sm:block">
            Store
          </a>
          <a href="/leadpluck" class="text-xs font-semibold text-zinc-400 hover:text-white transition-colors hidden sm:block">
            Features
          </a>
          <a href="/leadpluck/privacy" class="text-xs font-semibold text-zinc-400 hover:text-white transition-colors">
            Privacy Policy
          </a>
          <!-- Action CTA -->
          <a 
            href="https://github.com/UtkarshKarale" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-flex items-center gap-1.5 text-xs font-bold px-4 py-2 rounded-xl bg-purple-600 hover:bg-purple-500 text-white shadow-lg shadow-purple-600/25 transition-all hover:scale-105"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Get Extension
          </a>
        </nav>
      </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-grow pt-16">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-zinc-800 bg-[#09090b] py-12 text-zinc-400 text-sm">
      <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="flex items-center gap-3">
          <div class="w-6 h-6 rounded bg-gradient-to-br from-purple-500 to-indigo-600 flex items-center justify-center text-white text-xs font-black">
            LP
          </div>
          <p class="text-xs text-zinc-400">&copy; {currentYear} LeadPluck. 100% Local-first & Privacy-focused. Built by Utkarsh Karale.</p>
        </div>
        
        <div class="flex items-center gap-6 text-xs font-medium">
          <a href="/leadpluck" class="hover:text-white transition-colors">Landing Page</a>
          <a href="/leadpluck/privacy" class="hover:text-white transition-colors">Privacy Policy</a>
          <a href="/projects/cleanupload" class="hover:text-white transition-colors">CleanUpload</a>
          <a href="/" class="hover:text-white transition-colors">Portfolio</a>
        </div>
      </div>
    </footer>
  </body>
</html>
