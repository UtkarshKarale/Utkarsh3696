---
import '../styles/global.css';
import CustomCursor from '../components/CustomCursor.astro';
import PrivacyConsentBanner from '../components/PrivacyConsentBanner.astro';
import UpdateNotificationBanner from '../components/UpdateNotificationBanner.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: URL;
  type?: 'website' | 'article';
}

const {
  title = 'Utkarsh Karale — Full-Stack Developer & AI Engineer Portfolio',
  description = 'Portfolio of Utkarsh Karale, a Full-Stack Software Engineer and AI Engineer specializing in scalable web apps, AI tools, and robust software architecture.',
  image = '/og-image.png',
  canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://utkarshkarale.github.io'),
  type = 'website',
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://utkarshkarale.github.io';

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${siteUrl}/#person`,
      "name": "Utkarsh Karale",
      "url": `${siteUrl}/`,
      "jobTitle": "Full-Stack Developer & AI Engineer",
      "sameAs": [
        "https://github.com/UtkarshKarale",
        "https://www.linkedin.com/in/utkarshkarale"
      ],
      "knowsAbout": [
        "Full-Stack Development",
        "AI Engineering",
        "React",
        "Astro",
        "Node.js",
        "Python",
        "Machine Learning"
      ]
    },
    {
      "@type": type === 'article' ? 'BlogPosting' : 'WebSite',
      "name": title,
      "description": description,
      "url": canonicalURL.toString(),
      "image": new URL(image, Astro.site || 'https://utkarshkarale.github.io').toString(),
      "author": { "@id": `${siteUrl}/#person` }
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="9DuiJr3K2mPR1BCF17ODhJj0fGNrDUddrRWFXc-s_Kc" />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="utkarsh, utkarshkarale, utkarsh full stack developer, utkarsh ai engineer, ai engineer portfolio, full stack developer portfolio, cleanupload, monitoro, software engineer" />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site || 'https://example.com')} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.site || 'https://example.com')} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Tally Popup Script -->
    <script async src="https://tally.so/widgets/embed.js"></script>

    <style>
      /* Clean subtle scrollbar */
      ::-webkit-scrollbar { width: 6px; }
      ::-webkit-scrollbar-track { background: #f8fafc; }
      ::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 999px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #94a3b8;
      }
      * { scrollbar-width: thin; scrollbar-color: #cbd5e1 #f8fafc; }
    </style>
  </head>
  <body class="bg-white text-gray-900 font-sans antialiased min-h-screen flex flex-col relative">
    <!-- Minimal Light Background Effect (Dot Pattern) -->
    <div class="fixed inset-0 z-[-1] h-full w-full bg-white bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] [background-size:16px_16px]"></div>
    
    <CustomCursor />
    <UpdateNotificationBanner />
    <main class="flex-grow">
      <slot />
    </main>

    <PrivacyConsentBanner />

    <!-- Floating Draggable Handle Button (Bottom-Right) -->
    <div id="tally-floating-btn-container" style="position: fixed; bottom: 24px; right: 24px; z-index: 99999; touch-action: none; user-select: none;">
      <button 
        id="tally-floating-btn" 
        data-tally-open="xVrYkE" 
        class="flex items-center gap-2 bg-black hover:bg-gray-800 text-white px-4 py-2.5 rounded-full shadow-2xl border border-gray-700/50 text-sm font-semibold transition-transform hover:scale-105 cursor-grab active:cursor-grabbing" 
        style="box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.45);"
      >
        <span class="text-gray-400 text-xs font-mono tracking-tighter cursor-grab select-none" title="Drag to move">⋮⋮</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 21 1.9-5.7a8.5 8.5 0 1 1 3.8 3.8z"/></svg>
        <span>Say Hello</span>
      </button>
    </div>

    <script is:inline>
      (function() {
        const c = document.getElementById("tally-floating-btn-container");
        const b = document.getElementById("tally-floating-btn");
        if (!c || !b) return;

        let dragging = false;
        let moved = false;
        let startX, startY, initX, initY;

        function onDown(e) {
          dragging = true;
          moved = false;
          const p = e.touches ? e.touches[0] : e;
          startX = p.clientX;
          startY = p.clientY;
          const rect = c.getBoundingClientRect();
          initX = rect.left;
          initY = rect.top;
        }

        function onMove(e) {
          if (!dragging) return;
          const p = e.touches ? e.touches[0] : e;
          const dx = p.clientX - startX;
          const dy = p.clientY - startY;
          if (Math.hypot(dx, dy) > 6) {
            moved = true;
          }
          let x = Math.max(10, Math.min(window.innerWidth - c.offsetWidth - 10, initX + dx));
          let y = Math.max(10, Math.min(window.innerHeight - c.offsetHeight - 10, initY + dy));
          c.style.left = x + 'px';
          c.style.top = y + 'px';
          c.style.bottom = 'auto';
          c.style.right = 'auto';
        }

        function onUp() {
          dragging = false;
        }

        b.addEventListener('click', function(e) {
          if (moved) {
            e.preventDefault();
            e.stopImmediatePropagation();
          }
        }, true);

        c.addEventListener('mousedown', onDown);
        window.addEventListener('mousemove', onMove);
        window.addEventListener('mouseup', onUp);

        c.addEventListener('touchstart', onDown, { passive: true });
        window.addEventListener('touchmove', onMove, { passive: false });
        window.addEventListener('touchend', onUp);
      })();
    </script>
  </body>
</html>