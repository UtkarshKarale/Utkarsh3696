---
import FlowRupeeLayout from '../../layouts/FlowRupeeLayout.astro';

const faqs = [
  {
    q: "How does FlowRupee track expenses without cloud servers?",
    a: "FlowRupee uses a high-performance local SQLite database directly on your Android device. All transaction amounts, category tags, split calculations, and monthly budgets are stored in private local storage. No financial data ever hits a remote server."
  },
  {
    q: "Does FlowRupee require bank account logins or OTPs?",
    a: "No. FlowRupee never asks for your internet banking credentials, debit card numbers, or SMS OTPs. You can log payments manually in under 3 seconds or allow local on-device transaction parsing without compromising your bank security."
  },
  {
    q: "How does group bill splitting work with flatmates or trips?",
    a: "You can create unlimited groups for rent, groceries, trips, or dining out. FlowRupee's debt minimization algorithm calculates the exact minimum transactions required to settle up balances so you avoid awkward multiple payment reminders."
  },
  {
    q: "Is there any advertising or data sharing with credit bureaus?",
    a: "None. FlowRupee is 100% ad-free and privacy-first. Your financial habits are never packaged, sold, or shared with third-party advertisers, loan lenders, or credit profiling platforms."
  },
  {
    q: "Can I use FlowRupee completely offline without Wi-Fi or mobile data?",
    a: "Yes. FlowRupee is engineered offline-first. It functions seamlessly in remote locations, flight mode, or subway transits with zero network latency."
  }
];
---

<FlowRupeeLayout 
  title="FlowRupee — 100% Offline Personal Finance & Split Bills Android App"
  description="Take control of your money with FlowRupee. 3-second rapid expense logging, roommate bill settlements, category budgets, biometric security, and 100% private offline storage."
>
  <!-- Hero Section -->
  <section class="relative pt-24 pb-20 overflow-hidden">
    <!-- Ambient Green Glows -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[650px] h-[360px] bg-emerald-500/15 blur-[140px] rounded-full pointer-events-none"></div>
    <div class="absolute top-12 right-[10%] w-[380px] h-[260px] bg-teal-500/10 blur-[130px] rounded-full pointer-events-none"></div>

    <div class="max-w-5xl mx-auto px-6 relative z-10 text-center">
      <!-- Status Badge -->
      <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-emerald-950/60 border border-emerald-500/30 text-emerald-300 text-xs font-semibold mb-8 shadow-md">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Google Play Live</span>
        <span class="text-zinc-600">•</span>
        <span class="text-zinc-400 font-mono">100% Offline &amp; Private</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-6xl md:text-7xl font-black tracking-tight text-white mb-6 leading-[1.08]">
        TRACK YOUR MONEY.<br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-green-300">
          ZERO BANK LOGINS. 100% OFFLINE.
        </span>
      </h1>

      <!-- Subheadline -->
      <p class="text-base sm:text-xl text-zinc-300 max-w-2xl mx-auto mb-10 font-normal leading-relaxed">
        Log cash and UPI payments in under 3 seconds, effortlessly split group bills with roommates, and master your monthly budget without cloud servers or ads.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-14">
        <a 
          href="https://play.google.com/store/apps/details?id=online.jiapp.flowrupee" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-3.5 rounded-2xl bg-emerald-500 hover:bg-emerald-400 text-black font-extrabold text-sm shadow-xl shadow-emerald-500/25 transition-all hover:scale-105"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M5 3v18l15-9L5 3z"/></svg>
          <span>Get on Google Play</span>
        </a>
        <a 
          href="/flowrupee/policy" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-2xl bg-[#14231b] border border-emerald-900/80 hover:border-emerald-700 text-zinc-200 hover:text-white font-bold text-sm transition-all"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          <span>Privacy &amp; Security Policy</span>
        </a>
      </div>

      <!-- App Highlights Metric Row -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto text-left">
        <div class="p-5 rounded-2xl bg-[#101f17]/90 border border-emerald-950/90 shadow-sm">
          <div class="text-2xl font-black text-emerald-400 mb-1">&lt; 3 Sec</div>
          <div class="text-xs text-zinc-400 font-medium">Lightning-fast payment logging</div>
        </div>
        <div class="p-5 rounded-2xl bg-[#101f17]/90 border border-emerald-950/90 shadow-sm">
          <div class="text-2xl font-black text-teal-400 mb-1">0 Cloud</div>
          <div class="text-xs text-zinc-400 font-medium">Encrypted on-device SQLite storage</div>
        </div>
        <div class="p-5 rounded-2xl bg-[#101f17]/90 border border-emerald-950/90 shadow-sm">
          <div class="text-2xl font-black text-green-400 mb-1">Split Math</div>
          <div class="text-xs text-zinc-400 font-medium">Roommate and group debt minimizer</div>
        </div>
        <div class="p-5 rounded-2xl bg-[#101f17]/90 border border-emerald-950/90 shadow-sm">
          <div class="text-2xl font-black text-emerald-300 mb-1">Biometric</div>
          <div class="text-xs text-zinc-400 font-medium">Fingerprint &amp; Face Unlock secured</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Features Section -->
  <section id="features" class="py-24 border-t border-emerald-950/80 bg-[#0d1812]/50">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <h2 class="text-xs font-bold uppercase tracking-widest text-emerald-400 mb-3">Feature Highlights</h2>
        <p class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          Everything you need for daily financial peace of mind
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <!-- Feature 1 -->
        <div class="p-8 rounded-3xl bg-[#122219] border border-emerald-950/80 shadow-md flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            </div>
            <h3 class="text-xl font-bold text-white mb-3">3-Second Quick Logging</h3>
            <p class="text-sm text-zinc-400 leading-relaxed">
              Never forget an expense again. One-tap category chips (Food, Rent, Fuel, Grocery) and payment tags (UPI, Cash, Cards) let you log entries on the move without slow loading spinners.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-emerald-950/60 text-xs font-semibold text-emerald-400">
            Instant manual + UPI tag support
          </div>
        </div>

        <!-- Feature 2 -->
        <div class="p-8 rounded-3xl bg-[#122219] border border-emerald-950/80 shadow-md flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </div>
            <h3 class="text-xl font-bold text-white mb-3">Roommate &amp; Group Split</h3>
            <p class="text-sm text-zinc-400 leading-relaxed">
              Stop juggling multiple bill-splitting apps. FlowRupee simplifies balances among friends and flatmates, reducing complex group debts into the minimal number of direct settlements.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-emerald-950/60 text-xs font-semibold text-emerald-400">
            Zero awkward debt calculations
          </div>
        </div>

        <!-- Feature 3 -->
        <div class="p-8 rounded-3xl bg-[#122219] border border-emerald-950/80 shadow-md flex flex-col justify-between">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </div>
            <h3 class="text-xl font-bold text-white mb-3">Biometric &amp; Offline Privacy</h3>
            <p class="text-sm text-zinc-400 leading-relaxed">
              Lock the app with Android Biometrics (fingerprint or face unlock). Since your database lives exclusively on your phone's storage, no hacker, data breach, or scraper can access your balances.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-emerald-950/60 text-xs font-semibold text-emerald-400">
            100% client-side data isolation
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Accordion FAQ Section -->
  <section id="faq" class="py-24 border-t border-emerald-950/80">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center max-w-xl mx-auto mb-16">
        <h2 class="text-xs font-bold uppercase tracking-widest text-emerald-400 mb-3">Clear Answers</h2>
        <p class="text-3xl font-extrabold text-white tracking-tight">
          Frequently Asked Questions
        </p>
      </div>

      <div class="space-y-4">
        {faqs.map((faq, idx) => (
          <details 
            class="group rounded-2xl bg-[#112117] border border-emerald-950/90 overflow-hidden transition-all duration-300 open:border-emerald-700/60 open:shadow-lg open:shadow-emerald-950/40"
          >
            <summary class="flex items-center justify-between p-6 cursor-pointer text-base sm:text-lg font-bold text-white select-none hover:text-emerald-300 transition-colors">
              <span>{faq.q}</span>
              <span class="ml-4 shrink-0 p-1.5 rounded-lg bg-emerald-950/80 text-emerald-400 group-open:rotate-180 transition-transform duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
              </span>
            </summary>
            <div class="px-6 pb-6 text-sm sm:text-base text-zinc-300 leading-relaxed border-t border-emerald-950/50 pt-4">
              {faq.a}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Download Call-to-Action Banner -->
  <section class="py-20 border-t border-emerald-950/80 bg-gradient-to-b from-[#0d1812] to-[#08100c]">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <div class="w-16 h-16 rounded-2xl bg-emerald-500/20 border border-emerald-500/30 flex items-center justify-center mx-auto mb-6 text-emerald-400 shadow-xl shadow-emerald-500/10">
        <img src="/flowrupee-icon.png" alt="FlowRupee" class="w-10 h-10 object-contain" />
      </div>
      <h2 class="text-3xl sm:text-4xl font-black text-white mb-4 tracking-tight">
        Ready to take control of your daily expenses?
      </h2>
      <p class="text-base text-zinc-400 max-w-xl mx-auto mb-8">
        Free download on Google Play Store. Zero account logins required. Start tracking your wealth locally today.
      </p>

      <a 
        href="https://play.google.com/store/apps/details?id=online.jiapp.flowrupee" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="inline-flex items-center gap-2.5 px-8 py-4 rounded-2xl bg-emerald-500 hover:bg-emerald-400 text-black font-extrabold text-base shadow-xl shadow-emerald-500/30 transition-all hover:scale-105"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M5 3v18l15-9L5 3z"/></svg>
        <span>Download FlowRupee for Android</span>
      </a>

      <div class="mt-6 flex items-center justify-center gap-4 text-xs text-zinc-500">
        <span>Package: <code class="text-emerald-400 font-mono">online.jiapp.flowrupee</code></span>
        <span>&bull;</span>
        <a href="/flowrupee/policy" class="hover:text-zinc-300 underline underline-offset-4">Privacy Policy</a>
      </div>
    </div>
  </section>
</FlowRupeeLayout>
