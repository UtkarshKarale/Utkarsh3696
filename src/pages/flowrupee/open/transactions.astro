---
import FlowRupeeLayout from '../../../layouts/FlowRupeeLayout.astro';
---

<FlowRupeeLayout 
  title="Transactions & History — FlowRupee"
  description="View recent financial logs, expenses, and cashflow in FlowRupee."
>
  <section class="relative min-h-[85vh] flex items-center justify-center pt-24 pb-16 overflow-hidden">
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[550px] h-[300px] bg-emerald-500/15 blur-[130px] rounded-full pointer-events-none"></div>

    <div class="max-w-md w-full mx-auto px-6 relative z-10 text-center">
      <div class="w-20 h-20 mx-auto mb-6 rounded-3xl bg-gradient-to-br from-emerald-500 to-teal-700 p-0.5 shadow-xl shadow-emerald-950/50 flex items-center justify-center">
        <div class="w-full h-full bg-[#0b1510] rounded-[22px] flex items-center justify-center p-3">
          <img src="/flowrupee-icon.png" alt="FlowRupee" class="w-full h-full object-contain animate-pulse" />
        </div>
      </div>

      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-950/80 border border-emerald-500/30 text-emerald-300 text-xs font-semibold mb-4">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        <span id="status-text">Opening Transactions...</span>
      </div>

      <h1 class="text-2xl sm:text-3xl font-extrabold text-white mb-2">
        Transaction Ledger
      </h1>
      <p id="helper-text" class="text-sm text-zinc-300 mb-8">
        Review your categorized expenses, recent payments, and cash analytics.
      </p>

      <div class="flex flex-col gap-3.5">
        <a 
          id="open-app-btn"
          href="flowrupee://(tabs)/transactions"
          class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl bg-emerald-500 hover:bg-emerald-400 text-black font-bold text-sm shadow-lg shadow-emerald-500/25 transition-all active:scale-95"
        >
          View Transactions in App
        </a>

        <a 
          href="https://play.google.com/store/apps/details?id=online.jiapp.flowrupee"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 text-zinc-300 font-semibold text-sm transition-all"
        >
          Download on Google Play
        </a>
      </div>
    </div>
  </section>

  <script is:inline>
    (function() {
      var playStoreUrl = 'https://play.google.com/store/apps/details?id=online.jiapp.flowrupee';
      var schemeTarget = '(tabs)/transactions';
      var schemeUrl = 'flowrupee://' + schemeTarget;
      var intentUrl = 'intent://' + schemeTarget + '#Intent;scheme=flowrupee;package=online.jiapp.flowrupee;S.browser_fallback_url=' + encodeURIComponent(playStoreUrl) + ';end';

      var statusText = document.getElementById('status-text');
      var userAgent = navigator.userAgent || '';
      var isAndroid = /Android/i.test(userAgent);
      var isIOS = /iPhone|iPad|iPod/i.test(userAgent);

      if (!isAndroid && !isIOS) return;

      if (isAndroid) {
        window.location.href = intentUrl;
        var timer = setTimeout(function() {
          if (!document.hidden) {
            if (statusText) statusText.textContent = 'Redirecting to Google Play...';
            window.location.href = playStoreUrl;
          }
        }, 2200);

        var cancel = function() { clearTimeout(timer); };
        window.addEventListener('visibilitychange', function() { if (document.hidden) cancel(); });
        window.addEventListener('pagehide', cancel);
        window.addEventListener('blur', cancel);
      } else {
        window.location.href = schemeUrl;
        var timer = setTimeout(function() {
          if (!document.hidden) window.location.href = playStoreUrl;
        }, 1800);

        var cancel = function() { clearTimeout(timer); };
        window.addEventListener('visibilitychange', function() { if (document.hidden) cancel(); });
        window.addEventListener('pagehide', cancel);
        window.addEventListener('blur', cancel);
      }
    })();
  </script>
</FlowRupeeLayout>
