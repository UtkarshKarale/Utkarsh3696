---
import FlowRupeeLayout from '../../layouts/FlowRupeeLayout.astro';
---

<FlowRupeeLayout 
  title="Opening FlowRupee..."
  description="Smart deep link: opens FlowRupee app if installed, or redirects to Google Play Store."
>
  <section class="relative min-h-[85vh] flex items-center justify-center pt-24 pb-16 overflow-hidden">
    <!-- Ambient Green Glows -->
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[550px] h-[300px] bg-emerald-500/15 blur-[130px] rounded-full pointer-events-none"></div>

    <div class="max-w-md w-full mx-auto px-6 relative z-10 text-center">
      <!-- App Icon Card -->
      <div class="w-24 h-24 mx-auto mb-6 rounded-3xl bg-gradient-to-br from-emerald-500 to-teal-700 p-0.5 shadow-2xl shadow-emerald-950/60 flex items-center justify-center">
        <div class="w-full h-full bg-[#0b1510] rounded-[22px] flex items-center justify-center p-3">
          <img 
            src="/flowrupee-icon.png" 
            alt="FlowRupee App" 
            class="w-full h-full object-contain animate-pulse" 
          />
        </div>
      </div>

      <!-- Status Indicator -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-950/80 border border-emerald-500/30 text-emerald-300 text-xs font-semibold mb-4">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        <span id="status-text">Detecting FlowRupee App...</span>
      </div>

      <h1 class="text-2xl sm:text-3xl font-extrabold text-white mb-3">
        Opening in FlowRupee
      </h1>

      <p id="helper-text" class="text-sm text-zinc-300 mb-8 leading-relaxed">
        Connecting to FlowRupee. If you haven't installed the app yet, we'll take you to the Google Play Store automatically.
      </p>

      <!-- Primary Action Buttons -->
      <div class="flex flex-col gap-3.5">
        <a 
          id="open-app-btn"
          href="flowrupee://"
          class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl bg-emerald-500 hover:bg-emerald-400 text-black font-bold text-sm shadow-lg shadow-emerald-500/25 transition-all transform active:scale-95"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
          Open FlowRupee App
        </a>

        <a 
          id="play-store-btn"
          href="https://play.google.com/store/apps/details?id=online.jiapp.flowrupee"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl bg-zinc-900/90 hover:bg-zinc-800 border border-zinc-800 text-zinc-200 font-semibold text-sm transition-all"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M3.609 1.814L13.793 12 3.61 22.186c-.302-.275-.485-.68-.485-1.144V2.958c0-.464.183-.869.484-1.144zm11.306 11.308l2.586 2.586-12.39 7.08 9.804-9.666zm2.586-2.244L21.4 12.8c.8.457.8 1.2 0 1.657l-3.899 1.92-2.316-2.317 2.316-2.182zm-2.586-2.244L5.115 1.768l12.39 7.08-2.586 2.586z"/>
          </svg>
          Get on Google Play Store
        </a>
      </div>

      <!-- Quick Screen Navigation Links -->
      <div class="mt-10 pt-6 border-t border-zinc-800/80">
        <p class="text-xs font-semibold text-zinc-500 uppercase tracking-wider mb-3">
          Direct Screen Shortcuts
        </p>
        <div class="grid grid-cols-2 gap-2 text-xs">
          <a href="/flowrupee/open/split" class="p-2 rounded-xl bg-zinc-900/60 hover:bg-zinc-800/80 text-zinc-300 border border-zinc-800 transition">
            Split Bills
          </a>
          <a href="/flowrupee/open/friends" class="p-2 rounded-xl bg-zinc-900/60 hover:bg-zinc-800/80 text-zinc-300 border border-zinc-800 transition">
            Friend Requests
          </a>
          <a href="/flowrupee/open/transactions" class="p-2 rounded-xl bg-zinc-900/60 hover:bg-zinc-800/80 text-zinc-300 border border-zinc-800 transition">
            Transactions
          </a>
          <a href="/flowrupee" class="p-2 rounded-xl bg-zinc-900/60 hover:bg-zinc-800/80 text-zinc-300 border border-zinc-800 transition">
            App Overview
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Client-side Smart App Detection & Fallback -->
  <script is:inline>
    (function() {
      var urlParams = new URLSearchParams(window.location.search);
      var screen = urlParams.get('screen') || urlParams.get('target');
      var path = urlParams.get('path');

      var schemeTarget = '';
      if (screen === 'split' || screen === 'bill') {
        schemeTarget = '(tabs)/add?tab=split';
      } else if (screen === 'friends' || screen === 'friend_requests') {
        schemeTarget = 'friends/requests';
      } else if (screen === 'transactions') {
        schemeTarget = '(tabs)/transactions';
      } else if (screen === 'settings') {
        schemeTarget = 'settings';
      } else if (screen === 'scan' || screen === 'qr') {
        schemeTarget = 'scan';
      } else if (path) {
        schemeTarget = path.replace(/^\//, '');
      }

      var playStoreUrl = 'https://play.google.com/store/apps/details?id=online.jiapp.flowrupee';
      var schemeUrl = 'flowrupee://' + schemeTarget;
      
      // Android Intent with native Play Store fallback
      var intentUrl = 'intent://' + schemeTarget + '#Intent;scheme=flowrupee;package=online.jiapp.flowrupee;S.browser_fallback_url=' + encodeURIComponent(playStoreUrl) + ';end';

      var btn = document.getElementById('open-app-btn');
      if (btn) {
        btn.href = schemeUrl;
      }

      var statusText = document.getElementById('status-text');
      var helperText = document.getElementById('helper-text');
      var userAgent = navigator.userAgent || '';
      var isAndroid = /Android/i.test(userAgent);
      var isIOS = /iPhone|iPad|iPod/i.test(userAgent);
      var isMobile = isAndroid || isIOS;

      if (!isMobile) {
        if (statusText) statusText.textContent = 'Desktop View';
        if (helperText) helperText.textContent = 'This link is optimized for mobile. Scan or visit on your phone to open FlowRupee directly.';
        return;
      }

      if (isAndroid) {
        // Trigger Android intent: opens FlowRupee if installed, or Play Store if not installed
        if (statusText) statusText.textContent = 'Opening FlowRupee...';
        window.location.href = intentUrl;

        // Safety fallback timer if intent URI did not trigger automatically
        var fallbackTimer = setTimeout(function() {
          if (!document.hidden) {
            if (statusText) statusText.textContent = 'Redirecting to Google Play...';
            window.location.href = playStoreUrl;
          }
        }, 2200);

        var cancelFallback = function() {
          clearTimeout(fallbackTimer);
          if (statusText) statusText.textContent = 'Opened in FlowRupee';
        };

        window.addEventListener('visibilitychange', function() {
          if (document.hidden) cancelFallback();
        });
        window.addEventListener('pagehide', cancelFallback);
        window.addEventListener('blur', cancelFallback);
      } else {
        // iOS or alternative browser
        if (statusText) statusText.textContent = 'Opening FlowRupee...';
        var startTime = Date.now();
        window.location.href = schemeUrl;

        var timer = setTimeout(function() {
          var elapsed = Date.now() - startTime;
          if (!document.hidden && elapsed < 2800) {
            if (statusText) statusText.textContent = 'Opening Google Play...';
            window.location.href = playStoreUrl;
          }
        }, 1800);

        var cancelTimer = function() {
          clearTimeout(timer);
          if (statusText) statusText.textContent = 'Opened in FlowRupee';
        };

        window.addEventListener('visibilitychange', function() {
          if (document.hidden) cancelTimer();
        });
        window.addEventListener('pagehide', cancelTimer);
        window.addEventListener('blur', cancelTimer);
      }
    })();
  </script>
</FlowRupeeLayout>
