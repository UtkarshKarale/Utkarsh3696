---
import FlowRupeeLayout from '../../layouts/FlowRupeeLayout.astro';
---

<FlowRupeeLayout 
  title="Opening FlowRupee..."
  description="Deep link redirect into FlowRupee Android personal finance & bill split app."
>
  <section class="relative min-h-[80vh] flex items-center justify-center pt-24 pb-16 overflow-hidden">
    <!-- Ambient Green Glows -->
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 w-[550px] h-[300px] bg-emerald-500/15 blur-[130px] rounded-full pointer-events-none"></div>

    <div class="max-w-md w-full mx-auto px-6 relative z-10 text-center">
      <!-- App Icon Card -->
      <div class="w-24 h-24 mx-auto mb-6 rounded-3xl bg-gradient-to-br from-emerald-500 to-teal-700 p-0.5 shadow-2xl shadow-emerald-950/60 flex items-center justify-center">
        <div class="w-full h-full bg-[#0b1510] rounded-[22px] flex items-center justify-center p-3">
          <img 
            src="/flowrupee-icon.png" 
            alt="FlowRupee App" 
            class="w-full h-full object-contain animate-pulse" 
          />
        </div>
      </div>

      <!-- Status Indicator -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-emerald-950/80 border border-emerald-500/30 text-emerald-300 text-xs font-semibold mb-4">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        <span id="status-text">Redirecting to FlowRupee...</span>
      </div>

      <h1 class="text-2xl sm:text-3xl font-extrabold text-white mb-3">
        Opening in FlowRupee
      </h1>

      <p class="text-sm text-zinc-300 mb-8 leading-relaxed">
        If FlowRupee didn't open automatically on your phone, tap the button below to launch the app directly.
      </p>

      <!-- Primary Action Buttons -->
      <div class="flex flex-col gap-3.5">
        <a 
          id="open-app-btn"
          href="flowrupee://"
          class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl bg-emerald-500 hover:bg-emerald-400 text-black font-bold text-sm shadow-lg shadow-emerald-500/25 transition-all transform active:scale-95"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
          Open in FlowRupee App
        </a>

        <a 
          href="https://play.google.com/store/apps/details?id=online.jiapp.flowrupee"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl bg-zinc-900/90 hover:bg-zinc-800 border border-zinc-800 text-zinc-200 font-semibold text-sm transition-all"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M3.609 1.814L13.793 12 3.61 22.186c-.302-.275-.485-.68-.485-1.144V2.958c0-.464.183-.869.484-1.144zm11.306 11.308l2.586 2.586-12.39 7.08 9.804-9.666zm2.586-2.244L21.4 12.8c.8.457.8 1.2 0 1.657l-3.899 1.92-2.316-2.317 2.316-2.182zm-2.586-2.244L5.115 1.768l12.39 7.08-2.586 2.586z"/>
          </svg>
          Get App on Google Play
        </a>
      </div>

      <!-- Quick Screen Navigation Links -->
      <div class="mt-10 pt-6 border-t border-zinc-800/80">
        <p class="text-xs font-semibold text-zinc-500 uppercase tracking-wider mb-3">
          Direct Screen Shortcuts
        </p>
        <div class="grid grid-cols-2 gap-2 text-xs">
          <a href="/flowrupee/open/split" class="p-2 rounded-xl bg-zinc-900/60 hover:bg-zinc-800/80 text-zinc-300 border border-zinc-800 transition">
            Split Bills
          </a>
          <a href="/flowrupee/open/friends" class="p-2 rounded-xl bg-zinc-900/60 hover:bg-zinc-800/80 text-zinc-300 border border-zinc-800 transition">
            Friend Requests
          </a>
          <a href="/flowrupee/open/transactions" class="p-2 rounded-xl bg-zinc-900/60 hover:bg-zinc-800/80 text-zinc-300 border border-zinc-800 transition">
            Transactions
          </a>
          <a href="/flowrupee" class="p-2 rounded-xl bg-zinc-900/60 hover:bg-zinc-800/80 text-zinc-300 border border-zinc-800 transition">
            App Overview
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Client-side deep link resolver -->
  <script is:inline>
    (function() {
      var urlParams = new URLSearchParams(window.location.search);
      var screen = urlParams.get('screen') || urlParams.get('target');
      var path = urlParams.get('path');

      var schemeTarget = '';
      if (screen === 'split' || screen === 'bill') {
        schemeTarget = '(tabs)/add?tab=split';
      } else if (screen === 'friends' || screen === 'friend_requests') {
        schemeTarget = 'friends/requests';
      } else if (screen === 'transactions') {
        schemeTarget = '(tabs)/transactions';
      } else if (screen === 'settings') {
        schemeTarget = 'settings';
      } else if (path) {
        schemeTarget = path.replace(/^\//, '');
      }

      var deepLinkUrl = 'flowrupee://' + schemeTarget;

      var btn = document.getElementById('open-app-btn');
      if (btn) {
        btn.href = deepLinkUrl;
      }

      var statusText = document.getElementById('status-text');

      // Attempt immediate app open on mobile
      var isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
      if (isMobile) {
        window.location.href = deepLinkUrl;
        setTimeout(function() {
          if (statusText) {
            statusText.textContent = 'Ready to launch';
          }
        }, 2000);
      } else {
        if (statusText) {
          statusText.textContent = 'Mobile Deep Link';
        }
      }
    })();
  </script>
</FlowRupeeLayout>
