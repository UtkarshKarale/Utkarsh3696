---
import WebSticklyLayout from '../../layouts/WebSticklyLayout.astro';
import WebSticklyDemoScript from '../../components/WebSticklyDemoScript.astro';
---

<WebSticklyLayout title="WebStickly v1.0.0 — Pin sticky notes to any webpage">
  
  <!-- Hero Section -->
  <section class="relative min-h-[85vh] flex flex-col items-center justify-center pt-16 pb-16 overflow-hidden">
    
    <!-- Ambient Background Glows -->
    <div class="absolute top-[10%] left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-yellow-500/15 blur-[140px] rounded-full pointer-events-none"></div>
    <div class="absolute bottom-[-10%] left-[-10%] w-[500px] h-[350px] bg-amber-600/10 blur-[120px] rounded-full pointer-events-none"></div>
    
    <div class="max-w-5xl mx-auto px-6 relative z-10 flex flex-col items-center mt-6 text-center">
      
      <!-- Launch Status Pill -->
      <div class="inline-flex items-center gap-3 px-5 py-2 rounded-full bg-[#27272a]/90 border border-yellow-500/30 backdrop-blur-xl text-yellow-400 text-xs font-bold uppercase tracking-widest mb-8 shadow-2xl">
        <span class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-yellow-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-yellow-500"></span>
        </span>
        <span>WebStickly 1.0.0 Released · Chrome Web Store Review Pending</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-5xl sm:text-7xl md:text-8xl font-black tracking-tighter text-zinc-900 dark:text-white mb-6 leading-[0.95] max-w-4xl drop-shadow-2xl">
        PIN YOUR <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#facc15] via-[#fb923c] to-[#facc15] bg-[length:200%_auto] animate-gradient block mt-2">THOUGHTS.</span>
      </h1>
      
      <!-- Subheadline -->
      <p class="text-lg md:text-xl text-zinc-600 dark:text-zinc-400 mb-10 max-w-2xl font-medium leading-relaxed">
        The blazing fast, local-first browser extension for seamless web annotation. Always in context, completely private, right where you left it.
      </p>

      <!-- CTA Action Bar -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center w-full sm:w-auto">
        <button id="hero-install-btn" class="group relative inline-flex items-center justify-center rounded-2xl bg-gradient-to-r from-[#facc15] to-[#fb923c] text-black px-8 py-4 text-lg font-extrabold shadow-[0_0_30px_-5px_rgba(250,204,21,0.4)] hover:shadow-[0_0_45px_-5px_rgba(250,204,21,0.6)] hover:scale-[1.02] transition-all duration-300 gap-3 w-full sm:w-auto">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
          <span>Coming Soon on Chrome Web Store</span>
        </button>
        
        <a href="#features" class="inline-flex items-center justify-center rounded-2xl bg-zinc-100 dark:bg-zinc-900/80 border border-zinc-200 dark:border-zinc-700/60 text-zinc-700 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-white px-8 py-4 text-lg font-bold hover:bg-zinc-200 dark:hover:bg-zinc-800 hover:border-zinc-300 dark:hover:border-zinc-500 transition-all duration-300 gap-2 w-full sm:w-auto">
          Explore Features
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
        </a>
      </div>

      <!-- Quick Hint -->
      <div class="mt-8 flex items-center gap-2 text-xs font-mono text-zinc-500 bg-zinc-100 dark:bg-zinc-900/60 px-4 py-2 rounded-full border border-zinc-200 dark:border-zinc-800">
        <span>💡 Pro Tip: Press</span>
        <kbd class="px-2 py-0.5 bg-white dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-yellow-600 dark:text-yellow-400 rounded font-semibold">Alt + N</kbd>
        <span>anywhere on this page to test shortcut prompt!</span>
      </div>

    </div>
  </section>



  <!-- Features Bento Grid -->
  <section id="features" class="py-24 relative z-10 bg-zinc-50 dark:bg-[#18181b] border-t border-zinc-200 dark:border-zinc-800">
    <div class="max-w-6xl mx-auto px-6">
      
      <div class="mb-16 text-center">
        <h2 class="text-4xl md:text-5xl font-black text-zinc-900 dark:text-white mb-4">Engineered For Focus</h2>
        <p class="text-lg text-zinc-600 dark:text-zinc-400 max-w-xl mx-auto">No clutter. No account creation. WebStickly turns your browser into an intelligent notebook.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        
        <div class="md:col-span-2 bg-white dark:bg-zinc-900/60 shadow-sm dark:shadow-none rounded-3xl p-8 border border-zinc-200 dark:border-zinc-800 hover:border-yellow-500/40 dark:hover:border-yellow-500/40 transition-all">
          <div class="w-12 h-12 bg-yellow-500/10 border border-yellow-500/20 rounded-2xl flex items-center justify-center text-yellow-600 dark:text-yellow-400 mb-6 text-xl">📌</div>
          <h3 class="text-2xl font-bold text-zinc-900 dark:text-white mb-3">Contextual Sticky Notes</h3>
          <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Notes stick to exact web pages and scroll positions. Pick custom colors, resize cards, or minimize them when focusing. Hit <kbd class="px-2 py-0.5 bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 text-yellow-600 dark:text-yellow-400 rounded text-xs font-mono">Alt + N</kbd> to add notes in a click.
          </p>
        </div>

        <div class="bg-white dark:bg-zinc-900/60 shadow-sm dark:shadow-none rounded-3xl p-8 border border-zinc-200 dark:border-zinc-800 hover:border-emerald-500/40 dark:hover:border-emerald-500/40 transition-all">
          <div class="w-12 h-12 bg-emerald-500/10 border border-emerald-500/20 rounded-2xl flex items-center justify-center text-emerald-600 dark:text-emerald-400 mb-6 text-xl">🔒</div>
          <h3 class="text-2xl font-bold text-zinc-900 dark:text-white mb-3">100% Local Privacy</h3>
          <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Your notes stay strictly on your device inside <code class="text-xs bg-zinc-100 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 px-1.5 py-0.5 rounded text-yellow-600 dark:text-yellow-400">chrome.storage.local</code>. Zero tracking, zero telemetry, zero servers.
          </p>
        </div>

        <div class="bg-white dark:bg-zinc-900/60 shadow-sm dark:shadow-none rounded-3xl p-8 border border-zinc-200 dark:border-zinc-800 hover:border-blue-500/40 dark:hover:border-blue-500/40 transition-all">
          <div class="w-12 h-12 bg-blue-500/10 border border-blue-500/20 rounded-2xl flex items-center justify-center text-blue-600 dark:text-blue-400 mb-6 text-xl">🔑</div>
          <h3 class="text-2xl font-bold text-zinc-900 dark:text-white mb-3">Encrypted Backups</h3>
          <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Export and import backups securely using client-side AES-GCM 256-bit encryption for total peace of mind.
          </p>
        </div>

        <div class="md:col-span-2 bg-white dark:bg-zinc-900/60 shadow-sm dark:shadow-none rounded-3xl p-8 border border-zinc-200 dark:border-zinc-800 hover:border-purple-500/40 dark:hover:border-purple-500/40 transition-all">
          <div class="w-12 h-12 bg-purple-500/10 border border-purple-500/20 rounded-2xl flex items-center justify-center text-purple-600 dark:text-purple-400 mb-6 text-xl">⚡</div>
          <h3 class="text-2xl font-bold text-zinc-900 dark:text-white mb-3">Command Center Search</h3>
          <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Instantly search through all your web annotations from the extension popup. Filter by site, click to jump directly to pinned note locations with spotlight effects.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- Changelog Section -->
  <section id="changelog" class="py-24 relative z-10 bg-white dark:bg-[#141416] border-t border-zinc-200 dark:border-zinc-800">
    <div class="max-w-4xl mx-auto px-6">
      
      <div class="mb-12">
        <h2 class="text-3xl md:text-4xl font-black text-zinc-900 dark:text-white mb-4">What's New in v1.0.0</h2>
        <p class="text-lg text-zinc-600 dark:text-zinc-400">The official release of WebStickly is packed with new features to supercharge your local-first workflow.</p>
      </div>

      <div class="space-y-6 relative before:absolute before:inset-0 before:ml-5 before:-translate-x-px md:before:mx-auto md:before:translate-x-0 before:h-full before:w-0.5 before:bg-gradient-to-b before:from-transparent before:via-zinc-300 dark:before:via-zinc-800 before:to-transparent">
        
        <!-- Release Item 1 -->
        <div class="relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group is-active">
          <div class="flex items-center justify-center w-10 h-10 rounded-full border border-white dark:border-zinc-900 bg-yellow-500 text-white dark:text-zinc-900 shadow shrink-0 md:order-1 md:group-odd:-translate-x-1/2 md:group-even:translate-x-1/2 z-10">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg>
          </div>
          <div class="w-[calc(100%-4rem)] md:w-[calc(50%-2.5rem)] p-6 rounded-2xl bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 shadow-sm">
            <div class="flex items-center justify-between mb-2">
              <h4 class="font-bold text-zinc-900 dark:text-white text-lg">Dynamic Note Badge</h4>
              <time class="font-mono text-xs text-zinc-500 bg-zinc-100 dark:bg-zinc-800 px-2 py-1 rounded">New Feature</time>
            </div>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">The extension icon now displays a real-time count of sticky notes placed on the current webpage.</p>
          </div>
        </div>

        <!-- Release Item 2 -->
        <div class="relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group is-active">
          <div class="flex items-center justify-center w-10 h-10 rounded-full border border-white dark:border-zinc-900 bg-zinc-200 dark:bg-zinc-800 text-zinc-500 shadow shrink-0 md:order-1 md:group-odd:-translate-x-1/2 md:group-even:translate-x-1/2 z-10">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/></svg>
          </div>
          <div class="w-[calc(100%-4rem)] md:w-[calc(50%-2.5rem)] p-6 rounded-2xl bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 shadow-sm">
            <div class="flex items-center justify-between mb-2">
              <h4 class="font-bold text-zinc-900 dark:text-white text-lg">1-Click Copy</h4>
              <time class="font-mono text-xs text-zinc-500 bg-zinc-100 dark:bg-zinc-800 px-2 py-1 rounded">Enhancement</time>
            </div>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">Added a convenient copy button to the note header to quickly grab your annotations to your clipboard.</p>
          </div>
        </div>

        <!-- Release Item 3 -->
        <div class="relative flex items-center justify-between md:justify-normal md:odd:flex-row-reverse group is-active">
          <div class="flex items-center justify-center w-10 h-10 rounded-full border border-white dark:border-zinc-900 bg-zinc-200 dark:bg-zinc-800 text-zinc-500 shadow shrink-0 md:order-1 md:group-odd:-translate-x-1/2 md:group-even:translate-x-1/2 z-10">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <div class="w-[calc(100%-4rem)] md:w-[calc(50%-2.5rem)] p-6 rounded-2xl bg-zinc-50 dark:bg-zinc-900/50 border border-zinc-200 dark:border-zinc-800 shadow-sm">
            <div class="flex items-center justify-between mb-2">
              <h4 class="font-bold text-zinc-900 dark:text-white text-lg">AES-GCM Encryption</h4>
              <time class="font-mono text-xs text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 px-2 py-1 rounded">Security</time>
            </div>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">All backups are now fully encrypted using client-side AES-GCM 256-bit encryption before exporting.</p>
          </div>
        </div>

      </div>

    </div>
  </section>
</WebSticklyLayout>

  <WebSticklyDemoScript />
