---
import DaymarkLayout from '../../layouts/DaymarkLayout.astro';
---

<DaymarkLayout title="Daymark — Keep Your Important Days in Sight">
  
  <!-- Hero Section -->
  <section class="relative min-h-[85vh] flex flex-col items-center justify-center pt-16 pb-16 overflow-hidden">
    
    <!-- Ambient Background Glows -->
    <div class="absolute top-[10%] left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-blue-500/15 blur-[140px] rounded-full pointer-events-none"></div>
    <div class="absolute bottom-[-10%] left-[-10%] w-[500px] h-[350px] bg-indigo-600/10 blur-[120px] rounded-full pointer-events-none"></div>
    
    <div class="max-w-5xl mx-auto px-6 relative z-10 flex flex-col items-center mt-6 text-center">

      <!-- Main Headline -->
      <h1 class="text-5xl sm:text-7xl md:text-8xl font-black tracking-tighter text-zinc-900 dark:text-white mb-6 leading-[0.95] max-w-4xl drop-shadow-2xl">
        KEEP YOUR <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-500 via-indigo-500 to-blue-500 bg-[length:200%_auto] animate-gradient block mt-2">IMPORTANT DAYS IN SIGHT.</span>
      </h1>
      
      <!-- Subheadline -->
      <p class="text-lg md:text-xl text-zinc-600 dark:text-zinc-400 mb-10 max-w-2xl font-medium leading-relaxed">
        Create events like birthdays, exams, or launches, and see a floating countdown while you browse the web. Always remember what matters.
      </p>

      <!-- CTA Action Bar -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center items-center w-full sm:w-auto mb-16">
        <a href="#" id="hero-install-btn" class="group relative inline-flex items-center justify-center rounded-2xl bg-gradient-to-r from-blue-500 to-indigo-600 text-white px-8 py-4 text-lg font-extrabold shadow-[0_0_30px_-5px_rgba(59,130,246,0.4)] hover:shadow-[0_0_45px_-5px_rgba(59,130,246,0.6)] hover:scale-[1.02] transition-all duration-300 gap-3 w-full sm:w-auto">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
          <span>Add to Chrome</span>
        </a>
        
        <a href="#how-it-works" class="inline-flex items-center justify-center rounded-2xl bg-zinc-100 dark:bg-zinc-900/80 border border-zinc-200 dark:border-zinc-700/60 text-zinc-700 dark:text-zinc-300 hover:text-zinc-900 dark:hover:text-white px-8 py-4 text-lg font-bold hover:bg-zinc-200 dark:hover:bg-zinc-800 hover:border-zinc-300 dark:hover:border-zinc-500 transition-all duration-300 gap-2 w-full sm:w-auto">
          Learn More
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
        </a>
      </div>

      <!-- Product Preview Widget -->
      <div class="relative w-64 h-24 bg-zinc-900 rounded-2xl shadow-2xl overflow-hidden border border-zinc-700/50 flex flex-col items-center justify-center transform hover:scale-105 transition-transform duration-300 group cursor-default">
        <!-- Abstract gradient background for the widget -->
        <div class="absolute inset-0 bg-gradient-to-br from-orange-500/30 to-red-500/30 group-hover:opacity-100 transition-opacity"></div>
        <div class="absolute inset-0 backdrop-blur-[2px]"></div>
        
        <div class="relative z-10 text-center">
          <div class="text-white/80 text-xs font-semibold uppercase tracking-wider mb-1">Ganpati Aagaman</div>
          <div class="text-white text-3xl font-black drop-shadow-md">37 <span class="text-sm font-medium text-white/70">Days</span></div>
        </div>
      </div>

    </div>
  </section>

  <!-- How it Works -->
  <section id="how-it-works" class="py-24 relative z-10 bg-white dark:bg-[#141416] border-t border-zinc-200 dark:border-zinc-800">
    <div class="max-w-6xl mx-auto px-6">
      
      <div class="mb-16 text-center">
        <h2 class="text-4xl md:text-5xl font-black text-zinc-900 dark:text-white mb-4">How it works</h2>
        <p class="text-lg text-zinc-600 dark:text-zinc-400 max-w-xl mx-auto">Four simple steps to keep your important days visible.</p>
      </div>

      <div class="grid sm:grid-cols-2 md:grid-cols-4 gap-8">
        
        <div class="flex flex-col items-center text-center">
          <div class="w-16 h-16 rounded-full bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 flex items-center justify-center text-2xl font-bold mb-4 shadow-sm">1</div>
          <h3 class="text-xl font-bold text-zinc-900 dark:text-white mb-2">Create an Event</h3>
          <p class="text-zinc-600 dark:text-zinc-400 text-sm">Set the title, date, and time for your important upcoming day.</p>
        </div>

        <div class="flex flex-col items-center text-center">
          <div class="w-16 h-16 rounded-full bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 flex items-center justify-center text-2xl font-bold mb-4 shadow-sm">2</div>
          <h3 class="text-xl font-bold text-zinc-900 dark:text-white mb-2">Choose Style</h3>
          <p class="text-zinc-600 dark:text-zinc-400 text-sm">Pick custom images, GIF backgrounds, or simple colors for your widget.</p>
        </div>

        <div class="flex flex-col items-center text-center">
          <div class="w-16 h-16 rounded-full bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 flex items-center justify-center text-2xl font-bold mb-4 shadow-sm">3</div>
          <h3 class="text-xl font-bold text-zinc-900 dark:text-white mb-2">Browse the Web</h3>
          <p class="text-zinc-600 dark:text-zinc-400 text-sm">Go about your day, opening new tabs and reading articles.</p>
        </div>

        <div class="flex flex-col items-center text-center">
          <div class="w-16 h-16 rounded-full bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 flex items-center justify-center text-2xl font-bold mb-4 shadow-sm">4</div>
          <h3 class="text-xl font-bold text-zinc-900 dark:text-white mb-2">See Countdown</h3>
          <p class="text-zinc-600 dark:text-zinc-400 text-sm">A small, beautiful countdown widget floats unobtrusively on your screen.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- Features Bento Grid -->
  <section id="features" class="py-24 relative z-10 bg-zinc-50 dark:bg-[#18181b] border-t border-zinc-200 dark:border-zinc-800">
    <div class="max-w-6xl mx-auto px-6">
      
      <div class="mb-16 text-center">
        <h2 class="text-4xl md:text-5xl font-black text-zinc-900 dark:text-white mb-4">Everything You Need</h2>
        <p class="text-lg text-zinc-600 dark:text-zinc-400 max-w-xl mx-auto">A lightweight, powerful tool that respects your computer and your privacy.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        
        <div class="md:col-span-2 bg-white dark:bg-zinc-900/60 shadow-sm dark:shadow-none rounded-3xl p-8 border border-zinc-200 dark:border-zinc-800 hover:border-blue-500/40 dark:hover:border-blue-500/40 transition-all">
          <div class="w-12 h-12 bg-blue-500/10 border border-blue-500/20 rounded-2xl flex items-center justify-center text-blue-600 dark:text-blue-400 mb-6 text-xl">✨</div>
          <h3 class="text-2xl font-bold text-zinc-900 dark:text-white mb-3">Floating Countdown Widget & Custom Styles</h3>
          <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4">
            A non-intrusive widget overlay on your web pages keeps you updated. Make it yours by adding custom images, dynamic GIF backgrounds, and unique color schemes.
          </p>
          <div class="flex gap-2 flex-wrap">
            <span class="text-xs px-2 py-1 bg-zinc-100 dark:bg-zinc-800 rounded-md font-medium text-zinc-700 dark:text-zinc-300">Multiple Events</span>
            <span class="text-xs px-2 py-1 bg-zinc-100 dark:bg-zinc-800 rounded-md font-medium text-zinc-700 dark:text-zinc-300">Simple Management</span>
          </div>
        </div>

        <div class="bg-white dark:bg-zinc-900/60 shadow-sm dark:shadow-none rounded-3xl p-8 border border-zinc-200 dark:border-zinc-800 hover:border-emerald-500/40 dark:hover:border-emerald-500/40 transition-all">
          <div class="w-12 h-12 bg-emerald-500/10 border border-emerald-500/20 rounded-2xl flex items-center justify-center text-emerald-600 dark:text-emerald-400 mb-6 text-xl">🔒</div>
          <h3 class="text-2xl font-bold text-zinc-900 dark:text-white mb-3">100% Local Storage</h3>
          <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed">
            All your events stay securely on your device inside your browser's local storage.
          </p>
        </div>

        <div class="bg-white dark:bg-zinc-900/60 shadow-sm dark:shadow-none rounded-3xl p-8 border border-zinc-200 dark:border-zinc-800 hover:border-purple-500/40 dark:hover:border-purple-500/40 transition-all">
          <div class="w-12 h-12 bg-purple-500/10 border border-purple-500/20 rounded-2xl flex items-center justify-center text-purple-600 dark:text-purple-400 mb-6 text-xl">☁️</div>
          <h3 class="text-2xl font-bold text-zinc-900 dark:text-white mb-3">Zero Accounts</h3>
          <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed">
            No signups. No logins. Works flawlessly without any backend servers or cloud databases.
          </p>
        </div>

        <div class="md:col-span-2 bg-white dark:bg-zinc-900/60 shadow-sm dark:shadow-none rounded-3xl p-8 border border-zinc-200 dark:border-zinc-800 hover:border-orange-500/40 dark:hover:border-orange-500/40 transition-all">
          <div class="w-12 h-12 bg-orange-500/10 border border-orange-500/20 rounded-2xl flex items-center justify-center text-orange-600 dark:text-orange-400 mb-6 text-xl">📦</div>
          <h3 class="text-2xl font-bold text-zinc-900 dark:text-white mb-3">Backup & Restore</h3>
          <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed">
            Need to switch browsers or reinstall the extension? Easily export all your events and settings into a backup file, and restore them whenever needed with a single click.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- Privacy Section -->
  <section class="py-24 relative z-10 bg-white dark:bg-[#141416] border-t border-zinc-200 dark:border-zinc-800">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-4xl font-black text-zinc-900 dark:text-white mb-6">Your events stay in your browser.</h2>
      <p class="text-xl text-zinc-600 dark:text-zinc-400 mb-10 leading-relaxed">
        We built Daymark with a strict privacy-first mindset. The extension does not require an account, has no tracking, and currently stores all your event data locally on your machine.
      </p>
      <a href="/daymark/privacy" class="inline-flex items-center text-blue-600 dark:text-blue-400 font-bold hover:underline gap-1">
        Read our full Privacy Policy
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-24 relative z-10 bg-zinc-50 dark:bg-[#18181b] border-t border-zinc-200 dark:border-zinc-800">
    <div class="max-w-3xl mx-auto px-6">
      <h2 class="text-3xl md:text-4xl font-black text-zinc-900 dark:text-white mb-12 text-center">Frequently Asked Questions</h2>
      
      <div class="space-y-6">
        
        <div class="bg-white dark:bg-zinc-900/50 p-6 rounded-2xl border border-zinc-200 dark:border-zinc-800 shadow-sm">
          <h4 class="font-bold text-lg text-zinc-900 dark:text-white mb-2">Do I need an account?</h4>
          <p class="text-zinc-600 dark:text-zinc-400">No, you do not need an account or to sign up to use Daymark. It works straight out of the box.</p>
        </div>

        <div class="bg-white dark:bg-zinc-900/50 p-6 rounded-2xl border border-zinc-200 dark:border-zinc-800 shadow-sm">
          <h4 class="font-bold text-lg text-zinc-900 dark:text-white mb-2">Where is my data stored?</h4>
          <p class="text-zinc-600 dark:text-zinc-400">All your event data is stored locally within your browser using Chrome's extension local storage APIs.</p>
        </div>

        <div class="bg-white dark:bg-zinc-900/50 p-6 rounded-2xl border border-zinc-200 dark:border-zinc-800 shadow-sm">
          <h4 class="font-bold text-lg text-zinc-900 dark:text-white mb-2">Does the extension track me or send my data to a server?</h4>
          <p class="text-zinc-600 dark:text-zinc-400">No. Daymark does not track your browsing history, and we do not operate a backend server to collect your data.</p>
        </div>

        <div class="bg-white dark:bg-zinc-900/50 p-6 rounded-2xl border border-zinc-200 dark:border-zinc-800 shadow-sm">
          <h4 class="font-bold text-lg text-zinc-900 dark:text-white mb-2">Can I backup and restore my events?</h4>
          <p class="text-zinc-600 dark:text-zinc-400">Yes! You can export your events and settings as a backup file from the extension menu and restore them whenever needed.</p>
        </div>

        <div class="bg-white dark:bg-zinc-900/50 p-6 rounded-2xl border border-zinc-200 dark:border-zinc-800 shadow-sm">
          <h4 class="font-bold text-lg text-zinc-900 dark:text-white mb-2">What happens if I uninstall the extension?</h4>
          <p class="text-zinc-600 dark:text-zinc-400">If you remove the extension or clear your browser's local storage, your event data will be permanently deleted unless you have exported a backup file first.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-32 relative z-10 bg-white dark:bg-[#141416] border-t border-zinc-200 dark:border-zinc-800 text-center overflow-hidden">
    <div class="absolute inset-0 bg-blue-500/5 dark:bg-blue-500/10"></div>
    <div class="max-w-4xl mx-auto px-6 relative z-10">
      <h2 class="text-5xl md:text-6xl font-black text-zinc-900 dark:text-white mb-8 tracking-tight">Start tracking the days that matter.</h2>
      <a href="#" class="inline-flex items-center justify-center rounded-2xl bg-gradient-to-r from-blue-500 to-indigo-600 text-white px-10 py-5 text-xl font-extrabold shadow-[0_0_30px_-5px_rgba(59,130,246,0.4)] hover:shadow-[0_0_45px_-5px_rgba(59,130,246,0.6)] hover:scale-[1.02] transition-all duration-300 gap-3">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
        Add to Chrome
      </a>
    </div>
  </section>

</DaymarkLayout>
