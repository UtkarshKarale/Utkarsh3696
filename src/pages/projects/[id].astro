---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { id: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

// Generate avatar initial or icon
const firstLetter = project.data.title.charAt(0).toUpperCase();

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://utkarshkarale.github.io';
const canonicalPageUrl = `${siteUrl}/projects/${project.id}`;

// Structured Data for Google Rich Snippets (BreadcrumbList + SoftwareApplication)
const projectStructuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": `${siteUrl}/`
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Projects",
          "item": `${siteUrl}/projects`
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": project.data.title,
          "item": canonicalPageUrl
        }
      ]
    },
    {
      "@type": "SoftwareApplication",
      "name": project.data.title,
      "description": project.data.description,
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "Web, Android, Windows, macOS, Linux",
      "url": canonicalPageUrl,
      "author": {
        "@type": "Person",
        "name": "Utkarsh Karale",
        "url": `${siteUrl}/`
      },
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    }
  ]
};
---

<BaseLayout 
  title={`${project.data.title} – Product & Store Listing | Utkarsh Karale`} 
  description={project.data.description}
>
  <script type="application/ld+json" set:html={JSON.stringify(projectStructuredData)} />
  <Header />
  
  <article class="pt-24 pb-20 max-w-4xl mx-auto px-6">
    <!-- Back to Projects Breadcrumb -->
    <div class="mb-8">
      <a href="/projects" class="inline-flex items-center gap-2 text-sm font-semibold text-gray-500 hover:text-black transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        Back to all projects
      </a>
    </div>

    <!-- Product Store Header Card -->
    <div class="bg-gray-50/80 border border-gray-200/90 rounded-3xl p-6 sm:p-10 mb-12 shadow-sm">
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-6">
        <!-- App Avatar / Icon -->
        <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl bg-gradient-to-br from-gray-900 via-gray-800 to-black flex items-center justify-center text-white shadow-xl flex-shrink-0 border-2 border-white text-4xl font-extrabold select-none">
          {firstLetter}
        </div>

        <div class="flex-grow">
          <div class="flex flex-wrap items-center gap-2 mb-2">
            {project.data.technologies.slice(0, 3).map((tech) => (
              <span class="inline-flex items-center rounded-full bg-white text-gray-800 border border-gray-200 px-2.5 py-0.5 text-xs font-bold uppercase tracking-wider shadow-2xs">
                {tech}
              </span>
            ))}
            <span class="inline-flex items-center rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 px-2.5 py-0.5 text-xs font-bold uppercase tracking-wider">
              Active Project
            </span>
          </div>

          <h1 class="text-3xl sm:text-4xl font-extrabold text-gray-900 tracking-tight leading-tight mb-2">
            {project.data.title}
          </h1>

          <p class="text-base sm:text-lg text-gray-600 font-medium leading-normal mb-4">
            {project.data.description}
          </p>

          <!-- CTA Buttons: Visit Website / View Source / Install -->
          <div class="flex flex-wrap items-center gap-3 pt-2">
            {project.data.liveUrl && (
              <a 
                href={project.data.liveUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center justify-center gap-2 rounded-xl bg-black text-white px-7 py-3 text-sm font-semibold hover:bg-gray-800 transition-all shadow-md hover:shadow-lg hover:-translate-y-0.5"
              >
                <span>Visit Project / App</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
              </a>
            )}

            {project.data.github && (
              <a 
                href={project.data.github} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center justify-center gap-2 rounded-xl bg-white text-gray-800 border border-gray-200 px-5 py-3 text-sm font-semibold hover:bg-gray-50 transition-colors shadow-2xs"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
                <span>View Source</span>
              </a>
            )}
          </div>
        </div>
      </div>
    </div>

    <!-- Main Content & Detailed Descriptions -->
    <div class="prose prose-gray max-w-none prose-headings:font-bold prose-headings:text-gray-900 prose-a:text-blue-600 prose-img:rounded-2xl">
      <Content />
    </div>

    <!-- Technical Specifications Card -->
    <div class="mt-14 pt-8 border-t border-gray-200 not-prose">
      <h3 class="text-xl font-bold text-gray-900 mb-4">Technical Specifications</h3>
      <div class="border border-gray-200 rounded-2xl overflow-hidden divide-y divide-gray-200 bg-white">
        <div class="flex justify-between px-6 py-3.5 text-sm">
          <span class="text-gray-500 font-medium">Project Name</span>
          <span class="text-gray-900 font-semibold">{project.data.title}</span>
        </div>
        <div class="flex justify-between px-6 py-3.5 text-sm">
          <span class="text-gray-500 font-medium">Stack & Technologies</span>
          <span class="text-gray-900 font-semibold">{project.data.technologies.join(', ')}</span>
        </div>
        <div class="flex justify-between px-6 py-3.5 text-sm">
          <span class="text-gray-500 font-medium">Author</span>
          <span class="text-gray-900 font-semibold">Utkarsh Karale</span>
        </div>
        {project.data.liveUrl && (
          <div class="flex justify-between px-6 py-3.5 text-sm">
            <span class="text-gray-500 font-medium">Production Link</span>
            <a href={project.data.liveUrl} target="_blank" rel="noopener noreferrer" class="text-blue-600 font-semibold hover:underline">
              {project.data.liveUrl}
            </a>
          </div>
        )}
      </div>
    </div>
  </article>
  
  <Footer />
</BaseLayout>
