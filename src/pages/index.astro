---
import BaseLayout from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BlogCard from '../components/BlogCard.astro';
import Experience from '../components/Experience.astro';
import Education from '../components/Education.astro';
import Skills from '../components/Skills.astro';
import Achievements from '../components/Achievements.astro';
import VisitorStats from '../components/VisitorStats.astro';
import ContactCTA from '../components/ContactCTA.astro';
import WebSticklyDemoScript from '../components/WebSticklyDemoScript.astro';

import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter(p => p.data.featured)
  .sort((a, b) => new Date(b.data.publishedAt || 0).valueOf() - new Date(a.data.publishedAt || 0).valueOf())
  .slice(0, 5);

const allPosts = await getCollection('blog');
const latestPosts = allPosts
  .filter(p => !p.data.draft)
  .sort((a, b) => new Date(b.data.publishedAt).valueOf() - new Date(a.data.publishedAt).valueOf())
  .slice(0, 3);
---

<BaseLayout 
  title="Utkarsh Karale — Full-Stack Engineer & Innovator"
  description="Portfolio of Utkarsh Karale, a Full-Stack Software Engineer specializing in scalable web applications, AI automation, and robust backend systems."
>
  <Header />
  
  <Hero />
  <About />

  <!-- <section class="max-w-4xl mx-auto px-6">
    <VisitorStats />
  </section> -->

  <Experience />
  <Education />
  <Skills />
  <Achievements />
  
  <section id="projects" class="py-20 border-t border-gray-100">
    <div class="max-w-4xl mx-auto px-6">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl font-bold text-gray-900">Featured Projects</h2>
        <a href="/projects" class="text-sm font-medium text-gray-600 hover:text-black">
          View all →
        </a>
      </div>
      
      <div class="grid md:grid-cols-2 gap-6">
        {featuredProjects.map(project => (
          <ProjectCard project={project} />
        ))}
      </div>
    </div>
  </section>
  
  <section id="blog" class="py-20 border-t border-gray-100">
    <div class="max-w-4xl mx-auto px-6">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-2xl font-bold text-gray-900">Latest Writing</h2>
        <a href="/blog" class="text-sm font-medium text-gray-600 hover:text-black">
          View all →
        </a>
      </div>
      
      <div class="grid md:grid-cols-3 gap-6">
        {latestPosts.map(post => (
          <BlogCard post={post} />
        ))}
      </div>
    </div>
  </section>

  <ContactCTA />

  <Footer />
  <WebSticklyDemoScript />
</BaseLayout>