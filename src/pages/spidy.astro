    <!-- Interactive Card Script -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Custom Cursor Logic
            const cursor = document.getElementById('spidey-cursor');
            document.addEventListener('mousemove', (e) => {
                cursor.style.transform = `translate3d(${e.clientX - 16}px, ${e.clientY - 16}px, 0)`;
            });
            
            // Add active states for hover on interactive elements
            document.querySelectorAll('a, button, .square-btn, .tilt-element, .hero-image-container').forEach(el => {
                el.addEventListener('mouseenter', () => cursor.classList.add('active'));
                el.addEventListener('mouseleave', () => cursor.classList.remove('active'));
            });

            const heroContainer = document.getElementById('hero-reveal');
            const heroTitle = document.getElementById('hero-title');
            if (!heroContainer) return;

            heroContainer.addEventListener('mousemove', (e) => {
                const rect = heroContainer.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                
                heroContainer.style.setProperty('--mouse-x', `${x}px`);
                heroContainer.style.setProperty('--mouse-y', `${y}px`);

                // Check if mouse is hovering near the face area (center-top)
                const xPercent = (x / rect.width) * 100;
                const yPercent = (y / rect.height) * 100;

                if (xPercent > 35 && xPercent < 65 && yPercent > 10 && yPercent < 50) {
                    if (heroTitle) heroTitle.innerHTML = 'It is <span>Utkarsh</span>';
                } else {
                    if (heroTitle) heroTitle.innerHTML = 'Who is <span>this?</span>';
                }
            });

            heroContainer.addEventListener('mouseleave', () => {
                if (heroTitle) heroTitle.innerHTML = 'Who is <span>this?</span>';
                setTimeout(() => {
                    heroContainer.style.setProperty('--mouse-x', `50%`);
                    heroContainer.style.setProperty('--mouse-y', `50%`);
                }, 400); 
            });

            // Spider Web Click Effect (SVG Version)
            document.addEventListener('click', (e) => {
                // Ignore clicks on links or buttons to preserve UX
                if (e.target.closest('a') || e.target.closest('button')) return;

                const webContainer = document.createElement('div');
                webContainer.className = 'spider-web-effect';
                webContainer.style.left = `${e.clientX}px`;
                webContainer.style.top = `${e.clientY}px`;
                
                webContainer.innerHTML = `
                    <svg viewBox="0 0 100 100" width="100%" height="100%">
                        <line x1="50" y1="50" x2="50" y2="0" class="web-line"/>
                        <line x1="50" y1="50" x2="85.35" y2="14.64" class="web-line"/>
                        <line x1="50" y1="50" x2="100" y2="50" class="web-line"/>
                        <line x1="50" y1="50" x2="85.35" y2="85.35" class="web-line"/>
                        <line x1="50" y1="50" x2="50" y2="100" class="web-line"/>
                        <line x1="50" y1="50" x2="14.64" y2="85.35" class="web-line"/>
                        <line x1="50" y1="50" x2="0" y2="50" class="web-line"/>
                        <line x1="50" y1="50" x2="14.64" y2="14.64" class="web-line"/>
                        
                        <polygon points="50,20 71.21,28.79 80,50 71.21,71.21 50,80 28.79,71.21 20,50 28.79,28.79" fill="none" stroke="rgba(255,255,255,0.4)" stroke-width="1"/>
                        <polygon points="50,35 60.6,40.4 65,50 60.6,59.6 50,65 39.4,59.6 35,50 39.4,40.4" fill="none" stroke="rgba(255,255,255,0.6)" stroke-width="0.5"/>
                    </svg>
                `;
                
                document.body.appendChild(webContainer);

                // Play sound
                const thwip = new Audio('/web-shooter.mp3'); 
                thwip.volume = 0.5;
                // thwip.play().catch(e => console.log('Audio autoplay prevented'));

                setTimeout(() => {
                    webContainer.remove();
                }, 1000);
            });

            // Scroll Reveal Observer
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                    }
                });
            }, { threshold: 0.1 });

            document.querySelectorAll('.scroll-reveal').forEach(el => observer.observe(el));
        });
    </script>
