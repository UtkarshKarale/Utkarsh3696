---
// Standalone page, no base layout to keep it completely isolated from the main portfolio
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const spidyProjects = allProjects
  .filter(p => p.data.featured)
  .sort((a, b) => new Date(b.data.publishedAt || 0).valueOf() - new Date(a.data.publishedAt || 0).valueOf())
  .slice(0, 4); // Get top 4 projects

const achievements = [
  {
    title: "Spotlight Award",
    organization: "TwoDots Software Solution",
    description: "Awarded for innovative work in AI automation, leading the creation of impactful tools like Clipman and Status AI. Recognized for creativity, ownership, and a forward-thinking mindset.",
  },
  {
    title: "AI Excellence Award",
    organization: "TwoDots Software Solution",
    description: "Honoured to receive the AI Excellence Award from Mayur Patil. Grateful for the recognition of my vision-to-execution approach and dedication to excellence in AI.",
  },
  {
    title: "Young Turks Merit Certificate",
    organization: "Naukri Campus",
    description: "Achievement unlocked! Proud to receive this recognition, which fuels my passion for continuous growth and innovation in my career.",
  },
  {
    title: "Star Coder of the Week",
    organization: "Qspiders",
    description: "Celebrating my Star Coder of the Week award! Proud to be part of a community that fosters growth and innovation. My love for coding only gets stronger every day!",
  },
  {
    title: "3rd Prize - Project Competition",
    organization: "AMGOI Vathar, Kolhapur",
    description: "Secured the 3rd Prize in the college-level Project Competition at the REFLEX event held at Ashokrao Mane Group of Institutions (AMGOI), Vathar, Kolhapur.",
  }
];

const experiences = [
  {
    role: "Full-Stack Developer",
    company: "TwoDots Software Solution",
    period: "Oct 2024 - Present",
    description: "Leading the development of minimal, high-performance digital products and scalable web applications."
  }
];
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Utkarsh Karale | Secret Portfolio</title>
    <!-- Using Inter font for that premium look -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-dark: #0b0c10;
            --bg-lighter: #1f2833;
            --spidey-red: #e31b23;
            --spidey-blue: #003e7d;
            --text-light: #c5c6c7;
            --text-white: #ffffff;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
            cursor: none !important;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-light);
            overflow-x: hidden;
        }

        /* --- Custom Scrollbar --- */
        ::-webkit-scrollbar {
            display: none;
        }

        /* --- Custom Spidey Cursor --- */
        .spidey-cursor {
            position: fixed;
            top: 0; left: 0;
            width: 32px; height: 32px;
            pointer-events: none;
            z-index: 99999;
            will-change: transform;
        }

        .spidey-cursor svg {
            transition: transform 0.2s ease, stroke 0.2s ease;
        }

        .spidey-cursor.active svg {
            transform: scale(1.3) rotate(45deg);
        }
        
        .spidey-cursor.active svg path,
        .spidey-cursor.active svg circle {
            stroke: var(--text-white) !important;
        }

        /* --- Custom Header --- */
        header {
            padding: 1rem 5%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            background-color: rgba(11, 12, 16, 0.9);
            backdrop-filter: blur(12px);
            position: sticky;
            top: 0;
            z-index: 50;
        }

        header .logo {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--text-white);
            text-decoration: none;
            letter-spacing: 1px;
        }

        header .logo span {
            color: var(--spidey-red);
        }

        header nav {
            display: flex;
            align-items: center;
            gap: 2rem;
        }

        .header-link {
            color: var(--text-light);
            text-decoration: none;
            font-weight: 600;
            font-size: 0.95rem;
            transition: color 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .header-link:hover {
            color: var(--spidey-red);
        }

        /* Square Inverted Buttons */
        .square-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            padding: 0.75rem 1.5rem;
            background-color: var(--spidey-red);
            color: var(--text-white) !important;
            border: 2px solid var(--spidey-red);
            text-decoration: none !important;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: all 0.3s ease;
            cursor: pointer;
            border-radius: 0; /* Strict square edges */
        }
        
        .square-btn:hover {
            background-color: var(--text-white);
            color: var(--spidey-red) !important;
            border-color: var(--text-white);
        }

        .square-btn.inverted {
            background-color: var(--text-white);
            color: var(--spidey-red) !important;
            border-color: var(--text-white);
        }

        .square-btn.inverted:hover {
            background-color: var(--spidey-red);
            color: var(--text-white) !important;
            border-color: var(--spidey-red);
        }

        /* --- Hero Section --- */
        .hero {
            position: relative;
            height: 100vh;
            display: flex;
            align-items: center;
            overflow: hidden;
        }

        .hero-content {
            position: relative;
            width: 50%;
            padding: 0 5% 0 10%;
            z-index: 10;
        }

        .hero-image-container {
            position: absolute;
            right: 0;
            top: 0;
            width: 50%;
            height: 100%;
            overflow: hidden;
            z-index: 0;
        }

        /* Subtle gradient to blend the edge of the image into the background */
        .hero-image-container::before {
            content: '';
            position: absolute;
            top: 0; left: -1px; bottom: 0;
            width: 150px;
            background: linear-gradient(to right, var(--bg-dark), transparent);
            z-index: 3;
            pointer-events: none;
        }

        .hero-bg-layer {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            object-position: center 20%;
            pointer-events: none;
        }

        .hero-base {
            z-index: 1;
            animation: spideyBodyGlow 3s infinite alternate ease-in-out;
            transition: filter 0.5s ease, transform 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            transform: scale(1.05);
        }

        @keyframes spideyBodyGlow {
            0% { filter: grayscale(10%) brightness(0.6) drop-shadow(0 0 5px rgba(227, 27, 35, 0.4)); }
            100% { filter: grayscale(10%) brightness(0.6) drop-shadow(0 0 30px rgba(227, 27, 35, 0.9)); }
        }

        .hero-reveal {
            z-index: 2;
            -webkit-mask-image: radial-gradient(circle 205px at var(--mouse-x, -1000px) var(--mouse-y, -1000px), black 0%, rgba(0,0,0,0.8) 40%, transparent 100%);
            mask-image: radial-gradient(circle 205px at var(--mouse-x, -1000px) var(--mouse-y, -1000px), black 0%, rgba(0,0,0,0.8) 40%, transparent 100%);
            -webkit-mask-repeat: no-repeat;
            mask-repeat: no-repeat;
            opacity: 0;
            filter: brightness(0.8);
            transition: opacity 0.4s ease, transform 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            transform: scale(1.05);
        }

        .hero-image-container:hover .hero-reveal {
            opacity: 1;
        }



        .hero-content h1 {
            font-size: 5rem;
            line-height: 1.1;
            font-weight: 800;
            color: var(--text-white);
            margin-bottom: 1.5rem;
        }

        .hero-content h1 span {
            background: linear-gradient(45deg, var(--text-white), var(--spidey-red));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero-content p {
            font-size: 1.3rem;
            line-height: 1.6;
            margin-bottom: 2.5rem;
        }



        /* --- Crime Scene Tape Divider --- */
        .tape-divider-container {
            position: relative;
            width: 100%;
            height: 150px;
            overflow: hidden;
            background-color: var(--bg-dark);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 4rem 0;
        }

        .crime-tape {
            position: absolute;
            width: 110%; /* slightly wider to cover rotation */
            height: 45px;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: 4px;
            display: flex;
            align-items: center;
            justify-content: space-around;
            font-size: 1.2rem;
            box-shadow: 0 5px 20px rgba(0,0,0,0.8);
            z-index: 10;
        }

        .crime-tape.red {
            background-color: var(--spidey-red);
            color: var(--text-white);
            transform: rotate(3deg);
        }

        .crime-tape.white {
            background-color: var(--text-white);
            color: var(--spidey-red);
            transform: rotate(-3deg);
            z-index: 9;
        }

        /* --- Skills Section --- */
        .skills-grid {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 1rem;
            max-width: 800px;
            margin: 0 auto;
        }

        .skill-tag {
            background: rgba(31, 40, 51, 0.8);
            border: 1px solid rgba(227, 27, 35, 0.3);
            color: var(--text-white);
            padding: 0.5rem 1.2rem;
            font-size: 0.95rem;
            font-weight: 600;
            border-radius: 4px;
            transition: all 0.3s ease;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
        }

        .skill-tag:hover {
            background: var(--spidey-red);
            border-color: var(--spidey-red);
            transform: translateY(-3px);
            box-shadow: 0 8px 15px rgba(227, 27, 35, 0.3);
        }

        .skill-card-3d {
            background: rgba(31, 40, 51, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.1);
            padding: 2rem;
            text-align: center;
            transition: transform 0.1s ease-out; /* JavaScript will handle the tilt */
            transform-style: preserve-3d;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }

        .skill-card-3d h3 {
            font-size: 1.5rem;
            color: var(--spidey-red);
            margin-bottom: 1rem;
            transform: translateZ(30px); /* Pop out effect */
        }
        
        .skill-card-3d p {
            transform: translateZ(20px);
            font-size: 0.95rem;
            opacity: 0.9;
        }

        /* --- Dummy Sections --- */
        .section {
            padding: 8rem 5%;
            max-width: 1400px;
            margin: 0 auto;
        }

        .section-title {
            font-size: 2.5rem;
            color: var(--text-white);
            margin-bottom: 3rem;
            text-align: center;
        }

        .section-title span {
            color: var(--spidey-red);
        }

        .grid-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
        }

        .card {
            background-color: var(--bg-lighter);
            padding: 3rem 2rem;
            border-radius: 20px;
            border: 1px solid rgba(255,255,255,0.05);
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.4s ease, border-color 0.3s ease;
            text-align: center;
            position: relative;
            overflow: hidden;
            z-index: 1;
        }

        .card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            background: linear-gradient(180deg, rgba(227,27,35,0) 0%, rgba(227,27,35,0.1) 100%);
            z-index: -1;
            opacity: 0;
            transition: opacity 0.4s ease;
        }

        .card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 30px rgba(227,27,35,0.2);
            border-color: rgba(227,27,35,0.5);
        }

        .card:hover::before {
            opacity: 1;
        }

        .card h3 {
            color: var(--text-white);
            font-size: 1.5rem;
            margin-bottom: 1rem;
            transition: color 0.3s ease;
        }

        .card:hover h3 {
            color: var(--spidey-red);
        }

        /* --- Dossier / Top Secret Files --- */
        .dossier-card {
            background: rgba(31, 40, 51, 0.4);
            border: 1px solid rgba(227, 27, 35, 0.2);
            border-left: 4px solid var(--spidey-red);
            padding: 2.5rem 2rem;
            position: relative;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .dossier-card::before {
            content: 'CLASSIFIED';
            position: absolute;
            top: 18px; right: -30px;
            background: var(--spidey-red);
            color: #fff;
            font-size: 0.65rem;
            font-weight: 800;
            padding: 4px 35px;
            transform: rotate(45deg);
            box-shadow: 0 0 10px rgba(0,0,0,0.5);
            letter-spacing: 3px;
        }

        .dossier-card:hover {
            background: rgba(31, 40, 51, 0.8);
            border-color: var(--spidey-red);
            transform: translateX(10px);
            box-shadow: -10px 10px 30px rgba(227, 27, 35, 0.15);
        }

        .dossier-card h3 {
            color: var(--text-white);
            font-size: 1.4rem;
        }

        .dossier-card .org {
            color: var(--spidey-red);
            font-size: 0.9rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        
        .dossier-card p {
            font-size: 0.95rem;
            line-height: 1.6;
            color: rgba(255, 255, 255, 0.7);
        }

        /* --- Timeline / Experience --- */
        .timeline {
            position: relative;
            max-width: 800px;
            margin: 0 auto;
            padding-left: 2rem;
        }

        .timeline::before {
            content: '';
            position: absolute;
            left: 0; top: 0; bottom: 0;
            width: 2px;
            background: rgba(255,255,255,0.1);
        }

        .timeline-item {
            position: relative;
            padding-bottom: 3rem;
        }

        .timeline-item::before {
            content: '';
            position: absolute;
            left: -34px; top: 0;
            width: 16px; height: 16px;
            border-radius: 50%;
            background: var(--bg-dark);
            border: 2px solid var(--spidey-red);
            transition: all 0.3s ease;
        }

        .timeline-item:hover::before {
            background: var(--spidey-red);
            box-shadow: 0 0 15px var(--spidey-red);
        }

        .timeline-date {
            color: var(--spidey-red);
            font-size: 0.9rem;
            font-weight: 600;
            margin-bottom: 0.5rem;
            letter-spacing: 1px;
        }

        .timeline-title {
            color: var(--text-white);
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 0.25rem;
        }

        .timeline-company {
            color: rgba(255,255,255,0.6);
            font-size: 1rem;
            margin-bottom: 1rem;
        }

        /* --- Scroll Reveal Animations --- */
        .scroll-reveal {
            opacity: 0;
            transform: translateY(40px) scale(0.95);
            transition: all 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }

        .scroll-reveal.visible {
            opacity: 1;
            transform: translateY(0) scale(1);
        }

        /* --- Ambient Background Animations --- */
        .ambient-orb {
            position: fixed;
            border-radius: 50%;
            filter: blur(150px);
            z-index: 0;
            pointer-events: none;
            opacity: 0.4;
            mix-blend-mode: screen;
            animation: floatOrb 20s infinite ease-in-out alternate;
        }

        .ambient-orb.red {
            width: 60vw;
            height: 60vh;
            background: radial-gradient(circle, rgba(227,27,35,0.4) 0%, transparent 70%);
            top: 20%;
            left: -10%;
        }

        .ambient-orb.blue {
            width: 60vw;
            height: 60vh;
            background: radial-gradient(circle, rgba(0,62,125,0.4) 0%, transparent 70%);
            bottom: 0%;
            right: -10%;
            animation-delay: -10s;
            animation-duration: 25s;
        }

        @keyframes floatOrb {
            0% { transform: translate(0, 0) scale(1); }
            33% { transform: translate(10vw, 15vh) scale(1.2); }
            66% { transform: translate(-5vw, 30vh) scale(0.9); }
            100% { transform: translate(15vw, -10vh) scale(1.1); }
        }

        /* --- Secure Comm Channel --- */
        .comm-channel {
            background: rgba(11, 12, 16, 0.8);
            border: 1px solid rgba(0, 62, 125, 0.5);
            border-radius: 12px;
            max-width: 600px;
            margin: 0 auto;
            overflow: hidden;
            box-shadow: 0 20px 50px rgba(0,0,0,0.5), 0 0 20px rgba(0, 62, 125, 0.2);
            backdrop-filter: blur(10px);
        }

        .comm-header {
            background: rgba(0, 62, 125, 0.2);
            padding: 1rem 1.5rem;
            display: flex;
            align-items: center;
            border-bottom: 1px solid rgba(0, 62, 125, 0.5);
        }

        .comm-header .status-dot {
            width: 10px; height: 10px;
            background: #2ecc71;
            border-radius: 50%;
            margin-right: 10px;
            box-shadow: 0 0 10px #2ecc71;
            animation: pulseGreen 2s infinite;
        }

        @keyframes pulseGreen {
            0% { box-shadow: 0 0 0 0 rgba(46, 204, 113, 0.4); }
            70% { box-shadow: 0 0 0 10px rgba(46, 204, 113, 0); }
            100% { box-shadow: 0 0 0 0 rgba(46, 204, 113, 0); }
        }

        .comm-header h3 {
            color: var(--text-white);
            font-size: 1rem;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        .comm-body {
            padding: 2rem;
        }

        .message-bubble {
            background: rgba(31, 40, 51, 0.8);
            border-left: 3px solid var(--spidey-red);
            padding: 1.2rem;
            border-radius: 0 12px 12px 12px;
            color: var(--text-light);
            line-height: 1.6;
            margin-bottom: 2rem;
            font-family: monospace;
            font-size: 0.95rem;
        }

        .comm-actions {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .dm-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 1rem;
            border-radius: 8px;
            text-decoration: none;
            font-weight: 600;
            font-size: 1rem;
            transition: all 0.3s ease;
            cursor: none;
        }

        .dm-btn.insta {
            background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
            color: white;
            border: none;
        }

        .dm-btn.insta:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(220, 39, 67, 0.3);
            color: white;
        }

        .dm-btn.linkedin {
            background: #0077b5;
            color: white;
            border: none;
        }

        .dm-btn.linkedin:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(0, 119, 181, 0.3);
            color: white;
        }

        /* --- Custom Footer --- */
        footer {
            background-color: #050608;
            padding: 4rem 5%;
            text-align: center;
            border-top: 1px solid rgba(255,255,255,0.05);
            margin-top: 4rem;
        }

        .footer-joke {
            font-size: 1.2rem;
            color: var(--text-light);
            max-width: 800px;
            margin: 0 auto 2rem auto;
            line-height: 1.6;
            font-weight: 400;
        }

        .footer-joke span {
            color: var(--spidey-red);
            font-weight: 600;
        }

        .social-links {
            display: flex;
            justify-content: center;
            gap: 2rem;
        }

        .social-links a {
            color: var(--text-light);
            text-decoration: none;
            transition: color 0.3s ease;
        }

        .social-links a:hover {
            color: var(--spidey-red);
        }

        /* Responsive */
        @media (max-width: 968px) {
            .hero {
                flex-direction: column;
                min-height: auto;
            }
            .hero-content {
                width: 100%;
                padding: 4rem 5%;
                text-align: center;
            }
            .hero-image-container {
                position: relative;
                width: 100%;
                height: 50vh;
            }
            .hero-image-container::before {
                width: 100%;
                height: 50px;
                background: linear-gradient(to bottom, var(--bg-dark), transparent);
            }
            .hero-content h1 {
                font-size: 3.5rem;
            }
        }

        /* Interactive Spidey Net Effect - Premium SVG Edition*/
        .spider-web-effect {
            position: fixed;
            pointer-events: none;
            width: 200px;
            height: 200px;
            margin-top: -100px;
            margin-left: -100px;
            z-index: 9999;
            animation: webShoot 0.8s cubic-bezier(0.1, 0.9, 0.2, 1) forwards;
            transform-origin: center;
        }

        .spider-web-effect .web-line {
            fill: none;
            stroke: rgba(227, 27, 35, 0.9);
            stroke-width: 1.5;
            stroke-linecap: round;
            stroke-linejoin: round;
            filter: drop-shadow(0 0 3px rgba(227,27,35,0.8));
        }

        @keyframes webShoot {
            0% { transform: scale(0.1) rotate(-15deg); opacity: 1; }
            40% { transform: scale(1.2) rotate(5deg); opacity: 0.9; }
            100% { transform: scale(1.8) rotate(15deg); opacity: 0; }
        }
        
        .project-card {
            text-decoration: none;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            min-height: 250px;
            padding: 2rem;
            text-align: left;
        }
        
        .project-card h3 {
            text-shadow: 0 2px 10px rgba(0,0,0,0.8);
        }
        
        .project-card p {
            text-shadow: 0 1px 5px rgba(0,0,0,0.8);
            font-size: 0.95rem;
            opacity: 0.9;
        }
    </style>
</head>
<body>
    <!-- Ambient Background Energy -->
    <div class="ambient-orb red"></div>
    <div class="ambient-orb blue"></div>
    <!-- Spidey Custom Cursor -->
    <div class="spidey-cursor" id="spidey-cursor">
        <svg width="32" height="32" viewBox="0 0 32 32">
