---
// Standalone AutoTune Page (Next-Level Premium DAW UI)
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>AutoTune Studio | Premium Pitch Correction</title>
  <style>
    /* 
      Next-Level Premium DAW Plugin Aesthetic
      Glassmorphism, Neon Accents, Dark UI
    */
    @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap');

    :root {
      --bg: #09090b;
      --panel: rgba(24, 24, 27, 0.6);
      --panel-border: rgba(255, 255, 255, 0.08);
      --text: #f8fafc;
      --text-muted: #94a3b8;
      --accent-1: #3b82f6; /* Blue */
      --accent-2: #8b5cf6; /* Purple */
      --accent-3: #ec4899; /* Pink */
      --danger: #ef4444;
      --success: #10b981;
      --radius: 16px;
      --font-main: 'Outfit', sans-serif;
      --font-mono: 'Space Mono', monospace;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background-color: var(--bg);
      background-image: 
        radial-gradient(circle at 15% 50%, rgba(59, 130, 246, 0.15), transparent 25%),
        radial-gradient(circle at 85% 30%, rgba(139, 92, 246, 0.15), transparent 25%);
      color: var(--text);
      font-family: var(--font-main);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 2rem;
      overflow-x: hidden;
    }

    .container {
      width: 100%;
      max-width: 680px;
      position: relative;
      z-index: 10;
    }

    /* Animated background glow behind panel */
    .container::before {
      content: '';
      position: absolute;
      top: -20px; left: -20px; right: -20px; bottom: -20px;
      background: linear-gradient(45deg, var(--accent-1), var(--accent-2), var(--accent-3));
      z-index: -1;
      filter: blur(60px);
      opacity: 0.15;
      animation: pulse-glow 8s infinite alternate;
      border-radius: 30px;
    }

    @keyframes pulse-glow {
      0% { opacity: 0.1; transform: scale(0.98); }
      100% { opacity: 0.25; transform: scale(1.02); }
    }

    .header {
      text-align: center;
      margin-bottom: 2rem;
    }

    .header h1 {
      font-size: 2.75rem;
      font-weight: 800;
      letter-spacing: -0.03em;
      margin-bottom: 0.5rem;
      background: linear-gradient(to right, #fff, #a5b4fc, #fbcfe8);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      text-transform: uppercase;
    }

    .header p {
      color: var(--text-muted);
      font-size: 1.1rem;
      font-weight: 300;
    }

    .panel {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    /* Visualizer */
    .visualizer-container {
      width: 100%;
      height: 200px;
      background: transparent;
      margin-bottom: 2rem;
      overflow: hidden;
      position: relative;
    }

    canvas {
      display: block;
      width: 100%;
      height: 100%;
    }
    
    .visualizer-label {
      position: absolute;
      top: 10px;
      left: 12px;
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: rgba(255, 255, 255, 0.4);
      font-weight: 600;
      font-family: var(--font-mono);
      pointer-events: none;
    }

    .status-indicator {
      position: absolute;
      top: 10px;
      right: 12px;
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.7rem;
      font-weight: 600;
      font-family: var(--font-mono);
      color: var(--text-muted);
    }

    .status-dot {
      width: 8px;
      height: 8px;
      background: var(--text-muted);
      border-radius: 50%;
      transition: all 0.3s ease;
    }

    .is-live .status-dot {
      background: var(--success);
      box-shadow: 0 0 10px var(--success);
      animation: blink 2s infinite;
    }

    .is-recording .status-dot {
      background: var(--danger);
      box-shadow: 0 0 10px var(--danger);
      animation: blink 1s infinite;
    }

    @keyframes blink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.4; }
    }

    /* Controls Grid */
    .control-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
      margin-bottom: 2rem;
    }

    .control-col {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    label {
      font-size: 0.8rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-muted);
    }

    select {
      width: 100%;
      background: transparent;
      border: 2px solid rgba(255,255,255,0.2);
      color: var(--text);
      padding: 0.875rem 1.5rem;
      border-radius: 99px;
      font-family: var(--font-main);
      font-weight: 600;
      font-size: 1rem;
      outline: none;
      transition: all 0.2s;
      appearance: none;
      background-image: url("data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22292.4%22%20height%3D%22292.4%22%3E%3Cpath%20fill%3D%22%2394a3b8%22%20d%3D%22M287%2069.4a17.6%2017.6%200%200%200-13-5.4H18.4c-5%200-9.3%201.8-12.9%205.4A17.6%2017.6%200%200%200%200%2082.2c0%205%201.8%209.3%205.4%2012.9l128%20127.9c3.6%203.6%207.8%205.4%2012.8%205.4s9.2-1.8%2012.8-5.4L287%2095c3.5-3.5%205.4-7.8%205.4-12.8%200-5-1.9-9.2-5.5-12.8z%22%2F%3E%3C%2Fsvg%3E");
      background-repeat: no-repeat;
      background-position: right 1rem top 50%;
      background-size: 0.65rem auto;
    }

    select:focus {
      border-color: var(--accent-2);
      box-shadow: 0 0 0 2px rgba(139, 92, 246, 0.2);
    }

    select option {
      background: var(--bg);
      color: var(--text);
    }

    /* Custom Slider */
    .slider-container {
      margin-bottom: 1.5rem;
      background: transparent;
      padding: 1.25rem 0;
      border-radius: 12px;
    }

    .range-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
    }

    .range-value {
      font-size: 1.1rem;
      font-weight: 700;
      font-family: var(--font-mono);
      color: var(--accent-1);
      background: rgba(59, 130, 246, 0.1);
      padding: 2px 8px;
      border-radius: 4px;
    }

    input[type="range"] {
      -webkit-appearance: none;
      width: 100%;
      height: 6px;
      background: rgba(255,255,255,0.1);
      border-radius: 3px;
      outline: none;
    }
    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: var(--text);
      cursor: pointer;
      border: 3px solid var(--accent-1);
      box-shadow: 0 0 15px var(--accent-1);
      transition: transform 0.1s;
    }
    input[type="range"]::-webkit-slider-thumb:hover {
      transform: scale(1.15);
    }

    /* Backing Track */
    .track-container {
      margin-bottom: 2.5rem;
    }
    
    .backing-track {
      width: 100%;
      height: 40px;
      border-radius: 8px;
      opacity: 0.8;
      transition: opacity 0.2s;
    }
    
    .backing-track:hover {
      opacity: 1;
    }

    /* Actions */
    .action-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      margin-bottom: 1rem;
    }

    .btn {
      padding: 1rem 1.5rem;
      border: 2px solid transparent;
      border-radius: 99px;
      font-size: 1rem;
      font-weight: 600;
      font-family: var(--font-main);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .btn:active {
      transform: scale(0.97);
    }

    .btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      pointer-events: none;
    }

    .btn svg {
      width: 18px;
      height: 18px;
    }

    .btn-mic {
      background: transparent;
      color: white;
      border-color: var(--accent-1);
    }
    .btn-mic:hover {
      background: rgba(59, 130, 246, 0.1);
      box-shadow: 0 0 15px rgba(59, 130, 246, 0.3);
    }
    .btn-mic.active {
      background: var(--accent-1);
      color: white;
      box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4);
    }

    .btn-record {
      background: transparent;
      color: var(--danger);
      border-color: var(--danger);
    }
    .btn-record:hover {
      background: rgba(239, 68, 68, 0.1);
    }
    .btn-record.active {
      background: var(--danger);
      color: white;
      box-shadow: 0 4px 15px rgba(239, 68, 68, 0.4);
      animation: pulse-red 2s infinite;
    }

    @keyframes pulse-red {
      0% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
      70% { box-shadow: 0 0 0 10px rgba(239, 68, 68, 0); }
      100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
    }

    .btn-download {
      grid-column: 1 / -1;
      background: var(--success);
      color: #000;
      box-shadow: 0 4px 15px rgba(16, 185, 129, 0.3);
      display: none; /* Hidden until recording exists */
    }
    .btn-download:hover {
      background: #34d399;
      box-shadow: 0 6px 20px rgba(16, 185, 129, 0.5);
    }
  </style>
</head>
<body>

  <div class="container">
    <div class="header">
      <h1>AutoTune Studio</h1>
      <p>Pro-Level Real-Time Vocal DSP Engine</p>
    </div>

    <div class="panel" style="background: transparent; box-shadow: none; padding: 0;">
      <!-- Visualizer (Now floats freely at top without card) -->
      <div class="visualizer-container" style="margin-bottom: 3rem;">
        <div class="status-indicator" id="statusIndicator">
          <div class="status-dot"></div>
          <span id="statusText">STANDBY</span>
        </div>
        <canvas id="visualizer"></canvas>
      </div>

      <!-- Controls Card (Rounded bordered buttons) -->
      <div class="control-grid">
        <div class="control-col">
          <label for="keySelect">Musical Key</label>
          <select id="keySelect">
            <option value="C">C</option>
            <option value="C#">C# / Db</option>
            <option value="D">D</option>
            <option value="D#">D# / Eb</option>
            <option value="E">E</option>
            <option value="F">F</option>
            <option value="F#">F# / Gb</option>
            <option value="G">G</option>
            <option value="G#">G# / Ab</option>
            <option value="A">A</option>
            <option value="A#">A# / Bb</option>
            <option value="B" selected>B</option>
          </select>
        </div>
        
        <div class="control-col">
          <label for="scaleSelect">Scale Type</label>
          <select id="scaleSelect">
            <option value="major">Major</option>
            <option value="natural_minor" selected>Natural Minor</option>
            <option value="harmonic_minor">Harmonic Minor</option>
            <option value="pentatonic_major">Pentatonic Major</option>
            <option value="pentatonic_minor">Pentatonic Minor</option>
            <option value="chromatic">Chromatic</option>
          </select>
        </div>
      </div>

      <div class="slider-container">
        <div class="range-header">
          <label for="speedSlider">Retune Speed (0 = Hard Snap)</label>
          <span class="range-value" id="speedValue">0</span>
        </div>
        <input type="range" id="speedSlider" min="0" max="100" value="0">
      </div>

      <div style="background: rgba(139, 92, 246, 0.1); border: 1px solid rgba(139, 92, 246, 0.3); padding: 1rem; border-radius: 12px; margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: center; gap: 0.5rem; color: var(--text-muted); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 18px; height: 18px; color: var(--accent-2);"><path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3"></path></svg>
        <span>Wear Headphones for the Best Effect</span>
      </div>

      <!-- Actions -->
      <div class="action-grid">
        <button id="btnConnect" class="btn btn-mic">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path><line x1="12" y1="19" x2="12" y2="22"></line></svg>
          <span id="btnConnectText">Connect Mic</span>
        </button>
        
        <button id="btnRecord" class="btn btn-record" disabled>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="3" fill="currentColor"></circle></svg>
          <span id="btnRecordText">Record</span>
        </button>

        <a id="btnDownload" class="btn btn-download" download="autotune-session.wav">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
          Download Session Mix
        </a>
      </div>
    </div>
  </div>

  <script is:inline src="/autotune/autotune.js"></script>
</body>
</html>
