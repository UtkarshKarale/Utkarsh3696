---
import StatusGridLayout from '../../layouts/StatusGridLayout.astro';

const permissions = [
  {
    icon: "image",
    title: "Photos & Media Access",
    manifest: "READ_MEDIA_IMAGES / READ_EXTERNAL_STORAGE",
    purpose: "Used ONLY when you tap 'फोटो निवडा' (Choose Photo) to select your personal portrait or business logo to display on the banner.",
    safety: "We never scan, scrape, or read your private gallery in the background. Only the specific image file you explicitly tap is loaded into your device's canvas."
  },
  {
    icon: "download",
    title: "Save to Device Storage",
    manifest: "WRITE_EXTERNAL_STORAGE / SavePhotosPermission",
    purpose: "Used ONLY to save the finished 1080x1080 high-definition poster or festival status into your device's Pictures / Gallery folder when you tap 'Download'.",
    safety: "StatusGrid only writes the newly generated image file that you created. It never touches, modifies, or deletes any other files on your phone."
  },
  {
    icon: "bell",
    title: "Festival & Daily Notifications",
    manifest: "POST_NOTIFICATIONS",
    purpose: "Sends timely morning alerts for upcoming Indian festivals (e.g., Diwali, Gudi Padwa, Shiv Jayanti) and daily suvichar so you never miss wishing family and supporters.",
    safety: "100% spam-free. We do not send ad promos. You can toggle notifications on or off anytime directly from your phone's app settings."
  },
  {
    icon: "video",
    title: "Video & Audio Capabilities",
    manifest: "READ_MEDIA_VIDEO",
    purpose: "Optional. Used only if you choose to attach festival music or extract background audio to create an animated video status.",
    safety: "Audio and video processing executes locally on-device. Your original media is never uploaded to public servers without your consent."
  },
  {
    icon: "globe",
    title: "Internet Connectivity",
    manifest: "INTERNET",
    purpose: "Downloads the latest high-resolution festive background graphics, synchronizes your saved profile across sessions, and enables 1-tap WhatsApp sharing.",
    safety: "All network traffic is encrypted using industry-standard TLS/HTTPS protocols via Cloudflare edge infrastructure."
  }
];

const faqs = [
  {
    q: "Why does StatusGrid ask for gallery and storage permissions?",
    a: "StatusGrid needs permission to access your photo gallery so you can choose your personal portrait or logo to feature on the festival poster. It also needs storage permission to save the rendered high-resolution (1080x1080) poster to your phone's Pictures gallery. StatusGrid never scans or reads your private photo collection."
  },
  {
    q: "Are my photos uploaded or stored on your servers?",
    a: "No. Poster composition, text rendering, and frame adjustments happen directly inside your device's browser canvas (HTML5 Canvas engine). Your photo is loaded into memory locally to generate the banner and is not stored or shared with any third party."
  },
  {
    q: "What is StatusCraft Studio (Canva Mode)?",
    a: "StatusCraft is an interactive design workspace inside StatusGrid that allows you to drag, zoom, and reposition your photo, name, designation, and social handles freely on the poster, with 8 authentic status frames (Classic, Leader, Simple, Festive, Patti, Glass, Fade, Only Name)."
  },
  {
    q: "Does StatusGrid contain ads or sell user information?",
    a: "No. StatusGrid has zero third-party banner ads, zero tracking trackers, and never sells, rents, or distributes user data, phone numbers, or photos to data brokers or advertising networks."
  },
  {
    q: "Can I use StatusGrid on web browsers without installing an app?",
    a: "Yes! StatusGrid is fully accessible as a Progressive Web App (PWA) at https://statusgrid.pages.dev on any mobile browser (Chrome, Safari, Brave) with full functionality, zero app store downloads required."
  },
  {
    q: "How can I request deletion of my account or saved profile?",
    a: "You can edit or clear your profile at any time in the app settings, or email karaleutkarsh3696@gmail.com with your registered email, and all associated profile records will be permanently erased within 24 hours."
  }
];
---

<StatusGridLayout 
  title="StatusGrid — Personalized Festival & Daily WhatsApp Status Maker | Privacy & Permissions"
  description="Create stunning festival and daily WhatsApp status posters with your photo, name, and 8+ official frames. Transparent permissions, 1080p HD export, and zero spam."
>
  <!-- Hero Section -->
  <section class="relative pt-24 pb-20 overflow-hidden">
    <!-- Ambient Green Glows -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[650px] h-[360px] bg-emerald-500/15 blur-[140px] rounded-full pointer-events-none"></div>
    <div class="absolute top-12 right-[10%] w-[380px] h-[260px] bg-teal-500/10 blur-[130px] rounded-full pointer-events-none"></div>

    <div class="max-w-5xl mx-auto px-6 relative z-10 text-center">
      <!-- Status Badge -->
      <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-emerald-950/60 border border-emerald-500/30 text-emerald-300 text-xs font-semibold mb-8 shadow-md">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>StatusGrid Studio v1.0.45</span>
        <span class="text-zinc-600">&bull;</span>
        <span class="text-zinc-400 font-mono">Web, Android PWA &amp; Mobile</span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-6xl md:text-7xl font-black tracking-tight text-white mb-6 leading-[1.08]">
        CREATE FESTIVAL STATUSES.<br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-green-300">
          YOUR PHOTO. YOUR BRAND. IN SECONDS.
        </span>
      </h1>

      <!-- Subheadline -->
      <p class="text-base sm:text-xl text-zinc-300 max-w-2xl mx-auto mb-10 font-normal leading-relaxed">
        Personalize high-resolution 1080p posters for Diwali, Shiv Jayanti, Gudi Padwa, and daily morning greetings in Marathi, Hindi &amp; English. 1-tap photo cutout, 8 authentic banner frames, and instant WhatsApp sharing.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-14">
        <a 
          href="https://statusgrid.pages.dev" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-3.5 rounded-2xl bg-emerald-500 hover:bg-emerald-400 text-black font-extrabold text-sm shadow-xl shadow-emerald-500/25 transition-all hover:scale-105"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          <span>Launch Web App (Free)</span>
        </a>
        <a 
          href="#permissions" 
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-2xl bg-[#0a1e15] border border-emerald-900/80 hover:border-emerald-700 text-zinc-200 hover:text-white font-bold text-sm transition-all"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
          <span>Permissions &amp; Safety Policy</span>
        </a>
      </div>

      <!-- App Highlights Metric Row -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto text-left">
        <div class="p-5 rounded-2xl bg-[#091811]/90 border border-emerald-950/90 shadow-sm">
          <div class="text-2xl font-black text-emerald-400 mb-1">50+ Designs</div>
          <div class="text-xs text-zinc-400 font-medium">Daily suvichar &amp; Indian festivals</div>
        </div>
        <div class="p-5 rounded-2xl bg-[#091811]/90 border border-emerald-950/90 shadow-sm">
          <div class="text-2xl font-black text-teal-400 mb-1">8 Frames</div>
          <div class="text-xs text-zinc-400 font-medium">Classic, Leader, Festive &amp; Glass</div>
        </div>
        <div class="p-5 rounded-2xl bg-[#091811]/90 border border-emerald-950/90 shadow-sm">
          <div class="text-2xl font-black text-green-400 mb-1">1080p HD</div>
          <div class="text-xs text-zinc-400 font-medium">Crystal clear canvas rendering</div>
        </div>
        <div class="p-5 rounded-2xl bg-[#091811]/90 border border-emerald-950/90 shadow-sm">
          <div class="text-2xl font-black text-emerald-300 mb-1">Client-Side</div>
          <div class="text-xs text-zinc-400 font-medium">Zero photo scraping or storage</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section id="features" class="py-20 border-t border-emerald-950/80 bg-[#040e09]">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-400 mb-3 block">Powerful Capabilities</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white mb-4">Everything You Need for Social Media Greetings</h2>
        <p class="text-zinc-400 text-sm sm:text-base">Designed for political leaders, small business owners, organizations, and individuals across Maharashtra and India.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Feature 1 -->
        <div class="p-6 rounded-2xl bg-[#071710] border border-emerald-900/40 hover:border-emerald-600/50 transition-all">
          <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center mb-5">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">Daily &amp; Festival Curated Catalog</h3>
          <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed">
            Automatic chronological calendar highlights upcoming celebrations (Diwali, Chhatrapati Shivaji Maharaj Jayanti, Gudi Padwa, Ganesh Chaturthi) alongside daily Good Morning suvichar and motivational quotes.
          </p>
        </div>

        <!-- Feature 2 -->
        <div class="p-6 rounded-2xl bg-[#071710] border border-emerald-900/40 hover:border-emerald-600/50 transition-all">
          <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center mb-5">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">1-Tap Background Removal Cutouts</h3>
          <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed">
            Smart on-device transparency detection removes backgrounds instantly to give you a polished studio cutout. Flip, zoom, and adjust coordinates freely without needing desktop Photoshop.
          </p>
        </div>

        <!-- Feature 3 -->
        <div class="p-6 rounded-2xl bg-[#071710] border border-emerald-900/40 hover:border-emerald-600/50 transition-all">
          <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center mb-5">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">8 Authentic Status Frames</h3>
          <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed">
            Switch between official banner styles in real-time: Classic, Leader (3-line hierarchy), Simple circular, Festive Gold plate, Cutout Patti, Frosted Glass, Fade overlay, or pure Name/Organization only.
          </p>
        </div>

        <!-- Feature 4 -->
        <div class="p-6 rounded-2xl bg-[#071710] border border-emerald-900/40 hover:border-emerald-600/50 transition-all">
          <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center mb-5">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">StatusCraft Live Studio (Canva Mode)</h3>
          <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed">
            Drag-and-drop workspace giving you complete control over photo positioning, name size, taglines, font styles (Yatra One, Baloo 2, Modak), theme colors, and 1-pixel precision nudge controls.
          </p>
        </div>

        <!-- Feature 5 -->
        <div class="p-6 rounded-2xl bg-[#071710] border border-emerald-900/40 hover:border-emerald-600/50 transition-all">
          <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center mb-5">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" x2="12" y1="2" y2="15"/></svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">1-Tap Direct WhatsApp Share</h3>
          <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed">
            Integrated with Web Share API and native Android share intents. Share poster graphics directly to WhatsApp Status, chats, and groups without saving cluttering files in your gallery first.
          </p>
        </div>

        <!-- Feature 6 -->
        <div class="p-6 rounded-2xl bg-[#071710] border border-emerald-900/40 hover:border-emerald-600/50 transition-all">
          <div class="w-12 h-12 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center mb-5">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
          </div>
          <h3 class="text-lg font-bold text-white mb-2">High-Res 1080x1080p HD Export</h3>
          <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed">
            Full-resolution PNG/JPEG exports optimized for social media feeds, WhatsApp stories, and print banners. No blurry compression or unwanted third-party watermarks.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Detailed Permissions & Transparency Section (Mandatory for Store & Safety) -->
  <section id="permissions" class="py-20 bg-[#030a06] border-t border-emerald-950/80">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-bold uppercase tracking-wider mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span>100% Permission Transparency</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white mb-4">Why StatusGrid Asks For Device Permissions</h2>
        <p class="text-zinc-400 text-sm sm:text-base">
          We believe in complete openness. StatusGrid requests only the exact minimum device capabilities required to let you design, render, and save your festival posters. Here is what each permission does and our strict privacy guarantee:
        </p>
      </div>

      <div class="space-y-4">
        {permissions.map((perm) => (
          <div class="p-6 rounded-2xl bg-[#06140d] border border-emerald-900/60 shadow-lg">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
              <h3 class="text-base sm:text-lg font-extrabold text-white flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                {perm.title}
              </h3>
              <span class="font-mono text-xs text-emerald-400 bg-emerald-950/80 px-2.5 py-1 rounded-md border border-emerald-800/60 self-start sm:self-auto">
                {perm.manifest}
              </span>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs sm:text-sm pt-2 border-t border-emerald-950/80">
              <div>
                <p class="font-bold text-zinc-300 mb-1">Why this permission is requested:</p>
                <p class="text-zinc-400 leading-relaxed">{perm.purpose}</p>
              </div>
              <div>
                <p class="font-bold text-emerald-400 mb-1">Our Privacy &amp; Security Guarantee:</p>
                <p class="text-zinc-400 leading-relaxed">{perm.safety}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Zero-Data-Selling Notice Banner -->
      <div class="mt-10 p-6 rounded-2xl bg-gradient-to-r from-emerald-950/60 via-[#071911] to-emerald-950/60 border border-emerald-500/30 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-emerald-500 text-black flex items-center justify-center font-black shrink-0">
            ✓
          </div>
          <div>
            <h4 class="text-sm font-bold text-white">Zero Data Selling &bull; Zero Private Photo Scraping</h4>
            <p class="text-xs text-zinc-400">StatusGrid does not sell personal information, does not show third-party ads, and does not retain your unedited photos on public servers.</p>
          </div>
        </div>
        <a 
          href="/statusgrid/privacy" 
          class="shrink-0 px-4 py-2 rounded-xl bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-300 text-xs font-bold border border-emerald-500/30 transition-colors"
        >
          Read Complete Privacy Policy &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section id="faq" class="py-20 bg-[#040e09] border-t border-emerald-950/80">
    <div class="max-w-4xl mx-auto px-6">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-400 mb-3 block">Got Questions?</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white mb-4">Frequently Asked Questions</h2>
        <p class="text-zinc-400 text-sm sm:text-base">Everything you need to know about StatusGrid, our privacy practices, and how your posters are crafted.</p>
      </div>

      <div class="space-y-4">
        {faqs.map((faq) => (
          <div class="p-6 rounded-2xl bg-[#071710] border border-emerald-900/40">
            <h3 class="text-base font-bold text-white mb-2">{faq.q}</h3>
            <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Bottom CTA Banner -->
  <section class="py-20 bg-[#030906] border-t border-emerald-950/80">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-3xl sm:text-4xl font-black text-white mb-4">Start Creating Your Festival Greetings Today</h2>
      <p class="text-zinc-400 text-sm sm:text-base max-w-xl mx-auto mb-8">
        Free to use, zero intrusive ads, client-side canvas rendering, and 1-tap WhatsApp status sharing.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a 
          href="https://statusgrid.pages.dev" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full sm:w-auto px-8 py-3.5 rounded-2xl bg-emerald-500 hover:bg-emerald-400 text-black font-extrabold text-sm shadow-xl shadow-emerald-500/25 transition-all hover:scale-105"
        >
          Open StatusGrid Studio
        </a>
        <a 
          href="/statusgrid/terms" 
          class="w-full sm:w-auto px-7 py-3.5 rounded-2xl bg-[#091811] border border-emerald-900/80 hover:border-emerald-700 text-zinc-300 hover:text-white font-bold text-sm transition-all"
        >
          Terms of Service
        </a>
      </div>
    </div>
  </section>
</StatusGridLayout>
