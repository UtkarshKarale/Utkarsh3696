<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="index,follow">
  <meta name="theme-color" content="#05110c">
  <title>Terms of Service — StatusGrid Festival & Daily Status Maker</title>
  <meta name="description" content="Review the Terms of Service for StatusGrid. Understand permissible use, user content ownership, prohibited activities, and service guidelines.">
  <link rel="canonical" href="https://utkarshkarale.github.io/statusgrid/terms">
  <link rel="icon" type="image/png" href="/statusgrid-icon.png">

